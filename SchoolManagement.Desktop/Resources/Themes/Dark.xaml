<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette derived from the phone app, with the requested deep
         blue-gray background (#1A252C). -->
    <SolidColorBrush x:Key="Brush.Background" Color="#1A252C" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#22313A" />
    <SolidColorBrush x:Key="Brush.SurfaceVariant" Color="#2C3E49" />
    <SolidColorBrush x:Key="Brush.Primary" Color="#8AB4F8" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="#062E6F" />
    <SolidColorBrush x:Key="Brush.PrimaryContainer" Color="#0842A0" />
    <SolidColorBrush x:Key="Brush.OnPrimaryContainer" Color="#D3E3FD" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E8EEF2" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#AAB7BF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#33454F" />
    <SolidColorBrush x:Key="Brush.NavRail" Color="#22313A" />
    <SolidColorBrush x:Key="Brush.StatusBar" Color="#162027" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#2C3E49" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#0842A0" />

    <SolidColorBrush x:Key="Brush.Success" Color="#81C995" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FDD663" />
    <SolidColorBrush x:Key="Brush.Info" Color="#8AB4F8" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F2B8B5" />

    <SolidColorBrush x:Key="Brush.Present" Color="#81C995" />
    <SolidColorBrush x:Key="Brush.Late" Color="#FDD663" />
    <SolidColorBrush x:Key="Brush.Excused" Color="#8AB4F8" />
    <SolidColorBrush x:Key="Brush.Unexcused" Color="#F2B8B5" />

    <SolidColorBrush x:Key="Brush.Paid" Color="#81C995" />
    <SolidColorBrush x:Key="Brush.PartiallyPaid" Color="#FDD663" />
    <SolidColorBrush x:Key="Brush.Unpaid" Color="#F2B8B5" />
    <SolidColorBrush x:Key="Brush.Exempted" Color="#8AB4F8" />

</ResourceDictionary>
