<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Phase D1 - Light theme shim.
         ThemeService replaces the dictionary whose Source contains
         "Resources/Themes/" so the switch stays a single remove/insert. The
         actual palette lives in Resources/Design/Colors.Light.xaml, which is
         also what the theme parity and contrast tests read.
         ===================================================================== -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SchoolManagement.Desktop;component/Resources/Design/Colors.Light.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
