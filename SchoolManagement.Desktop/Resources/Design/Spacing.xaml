<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- =====================================================================
         Phase D1 - 4px spacing grid.
         Space.N = N * 4px. Use Space.* for margins, paddings and gaps so the
         whole app shares one rhythm. Inset.* are ready-made Thickness values.
         ===================================================================== -->

    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">20</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.7">28</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>
    <sys:Double x:Key="Space.9">36</sys:Double>
    <sys:Double x:Key="Space.10">40</sys:Double>
    <sys:Double x:Key="Space.11">44</sys:Double>
    <sys:Double x:Key="Space.12">48</sys:Double>

    <!-- Control metrics -->
    <sys:Double x:Key="Control.Height">36</sys:Double>
    <sys:Double x:Key="Control.Height.Compact">32</sys:Double>
    <sys:Double x:Key="Control.Height.Large">44</sys:Double>
    <sys:Double x:Key="Control.IconSize">18</sys:Double>
    <sys:Double x:Key="Nav.RailWidth">248</sys:Double>
    <sys:Double x:Key="Nav.RailWidth.Compact">72</sys:Double>
    <sys:Double x:Key="Page.MaxWidth">1600</sys:Double>

    <!-- Ready-made Thickness values -->
    <Thickness x:Key="Inset.None">0</Thickness>
    <Thickness x:Key="Inset.Control">12,0</Thickness>
    <Thickness x:Key="Inset.Card">20</Thickness>
    <Thickness x:Key="Inset.Card.Compact">12</Thickness>
    <Thickness x:Key="Inset.Page">24</Thickness>
    <Thickness x:Key="Inset.Page.Wide">32</Thickness>
    <Thickness x:Key="Inset.List">8,4</Thickness>

</ResourceDictionary>
