                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- =====================================================================
         Phase D1 - Icon map (Segoe Fluent Icons, with Segoe MDL2 Assets as the
         Windows 10 fallback through Font.Family.Icons).

         Keys are grouped by destination, action and object. Directional icons
         (Back, Forward, ChevronLeft/Right, Export/Import, Undo/Redo) are also
         listed in Icon.Directional so the RTL mirror behaviour can flip them
         automatically instead of shipping a second glyph.
         ===================================================================== -->

