<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Phase D1 - Elevation.
         Soft, warm shadows only; never a hard black drop shadow. Effects are
         x:Shared="False" because WPF seals an effect the first time it is used
         and a second element then cannot take the same instance.
         ===================================================================== -->

    <DropShadowEffect x:Key="Shadow.Sm"
                      x:Shared="False"
                      BlurRadius="6"
                      ShadowDepth="1"
                      Direction="270"
                      Opacity="0.06"
                      Color="#000000" />

    <DropShadowEffect x:Key="Shadow.Md"
                      x:Shared="False"
                      BlurRadius="24"
                      ShadowDepth="4"
                      Direction="270"
                      Opacity="0.10"
                      Color="#000000" />

    <DropShadowEffect x:Key="Shadow.Lg"
                      x:Shared="False"
                      BlurRadius="40"
                      ShadowDepth="8"
                      Direction="270"
                      Opacity="0.16"
                      Color="#000000" />

</ResourceDictionary>
