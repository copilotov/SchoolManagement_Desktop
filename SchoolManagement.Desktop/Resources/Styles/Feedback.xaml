<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls">

    <!-- =====================================================================
         Phase D1 - Feedback surfaces: tooltips, progress, cards, banners,
         badges and modal overlays. Banners use a semantic container colour
         with its matching OnContainer text so contrast stays AA in both
         themes.
         ===================================================================== -->

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Element}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource Shadow.Md}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Determinate progress bar (indeterminate uses the ProgressRing control) -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Surface.Alt}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Pill}" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressRing: determinate arc or indeterminate spinner -->
    <Style TargetType="controls:ProgressRing">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Thickness" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Surface.Alt}" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="IsActive" Value="True" />
    </Style>

    <!-- Card: 12px radius, hairline border, soft shadow -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Card.Elevated" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Effect" Value="{StaticResource Shadow.Sm}" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Badge / chip: small pill label -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Alt}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Status dot -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <!-- Banners: one per semantic role -->
    <Style x:Key="Banner.Base" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Element}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Banner.Info" TargetType="Border" BasedOn="{StaticResource Banner.Base}">
        <Setter Property="Background" Value="{DynamicResource Info.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Info}" />
    </Style>

    <Style x:Key="Banner.Success" TargetType="Border" BasedOn="{StaticResource Banner.Base}">
        <Setter Property="Background" Value="{DynamicResource Success.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
    </Style>

    <Style x:Key="Banner.Warning" TargetType="Border" BasedOn="{StaticResource Banner.Base}">
        <Setter Property="Background" Value="{DynamicResource Warning.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
    </Style>

    <Style x:Key="Banner.Danger" TargetType="Border" BasedOn="{StaticResource Banner.Base}">
        <Setter Property="Background" Value="{DynamicResource Danger.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    </Style>

    <!-- Modal overlay + card (legacy keys kept for Phases 4-7 screens) -->
    <Style x:Key="EditorOverlay" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Overlay.Scrim}" />
    </Style>

    <Style x:Key="EditorCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
        <Setter Property="Width" Value="520" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Lg}" />
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

</ResourceDictionary>
