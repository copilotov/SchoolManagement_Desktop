<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls">

    <!-- =====================================================================
         Phase D3 - reusable component styles.

         A component never owns a colour: it names a semantic token, so the
         same component repaints instantly when ThemeService swaps the palette.
         The converters here are shared by every component and by the design
         gallery.
         ===================================================================== -->

    <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
    <controls:InverseStringToVisibilityConverter x:Key="InverseStringToVisibility" />
    <controls:ObjectToVisibilityConverter x:Key="ObjectToVisibility" />
    <controls:NullToVisibilityConverter x:Key="NullToVisibility" />
    <controls:InverseBoolConverter x:Key="InverseBool" />
    <controls:CountFormatConverter x:Key="CountFormat" />

    <!-- Card surface used by every D3 composite -->
    <Style x:Key="Component.Card" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
    </Style>

    <Style x:Key="Component.Card.Compact" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Inset.Card.Compact}" />
    </Style>

    <!-- Section heading inside a component card -->
    <Style x:Key="Component.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Component.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Toolbar buttons: compact Subtle role -->
    <Style x:Key="Component.ToolbarButton" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Compact}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="Component.IconButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="{StaticResource Control.Height.Compact}" />
        <Setter Property="Height" Value="{StaticResource Control.Height.Compact}" />
        <Setter Property="MinWidth" Value="{StaticResource Control.Height.Compact}" />
    </Style>

    <!-- Stat card -->
    <Style x:Key="Component.StatValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Large}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="Component.StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="Component.StatTrend" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Chips and badges -->
    <Style x:Key="Component.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Alt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Component.BadgeText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- Skeleton placeholder -->
    <Style x:Key="Component.Skeleton" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Alt}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Master-detail side panel -->
    <Style x:Key="Component.DetailPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Card.Compact}" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Wizard step marker -->
    <Style x:Key="Component.StepCircle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Alt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Component.StepTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Component.StepConnector" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Weekly schedule -->
    <Style x:Key="Component.ScheduleCell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Component.ScheduleSlot" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Accent.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Element}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Component.ScheduleSlotText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Accent.OnContainer}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Chart card -->
    <Style x:Key="Component.ChartCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Inset.Card.Compact}" />
        <Setter Property="MinHeight" Value="220" />
    </Style>

    <!-- QR preview paper -->
    <Style x:Key="Component.QrPaper" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Sm}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
