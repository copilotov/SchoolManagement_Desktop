<UserControl x:Class="SchoolManagement.Desktop.Views.StudentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:behaviors="clr-namespace:SchoolManagement.Desktop.Behaviors"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StudentsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="900"
             d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D5 - the student list.

         One view model owns the query, the chips, the table/card switch and the
         shared add/edit form. The table is the D3 DataTable (master-detail side
         panel + bulk bar); the card list is a virtualizing ListBox so a long
         roster never realizes every card. Every label, status and amount is
         already resolved by the view model or goes through {loc:Tr}.
         ===================================================================== -->

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding EditSelectedCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelEditorCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SaveEditorCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- A status cell with its own tone. The text comes from {loc:Tr}, so a
             language switch repaints it without rebuilding the grid. -->
        <DataTemplate x:Key="Students.StatusCell">
            <Border x:Name="Badge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Pill}"
                    BorderThickness="1"
                    Padding="8,2">
                <TextBlock x:Name="Label" Style="{StaticResource Component.BadgeText}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="active">
                    <Setter TargetName="Label" Property="Text" Value="{loc:Tr students.active}" />
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Success.Container}" />
                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Success}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Success.OnContainer}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="inactive">
                    <Setter TargetName="Label" Property="Text" Value="{loc:Tr students.inactive}" />
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Surface.Alt}" />
                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="withdrawn">
                    <Setter TargetName="Label" Property="Text" Value="{loc:Tr students.withdrawn}" />
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Warning.Container}" />
                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Warning}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Warning.OnContainer}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Quick profile of the selected row, inside the DataTable detail panel. -->
        <DataTemplate x:Key="Students.QuickProfile">
            <StackPanel>
                <TextBlock Style="{StaticResource Component.SectionTitle}"
                           TextTrimming="CharacterEllipsis"
                           Text="{loc:Tr students.quickProfile}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Text.BodyStrong}"
                               Text="{Binding FirstName}" />
                    <TextBlock Style="{StaticResource Text.BodyStrong}"
                               Margin="6,0,0,0"
                               Text="{Binding LastName}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Text.Numeric}"
                           Foreground="{DynamicResource Text.Secondary}"
                           Margin="0,2,0,0"
                           Text="{Binding StudentCode}" />

                <Border Style="{StaticResource Divider}" Margin="0,12" />

                <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr students.phone}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Phone}" />

                <TextBlock Style="{StaticResource Component.Hint}" Margin="0,8,0,0" Text="{loc:Tr students.filterLevel}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding LevelName}" />

                <TextBlock Style="{StaticResource Component.Hint}" Margin="0,8,0,0" Text="{loc:Tr students.filterGroup}" />
                <TextBlock Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" Text="{Binding GroupNames}" />

                <TextBlock Style="{StaticResource Component.Hint}" Margin="0,8,0,0" Text="{loc:Tr students.guardian}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding GuardianName}" />

                <TextBlock Style="{StaticResource Component.Hint}" Margin="0,8,0,0" Text="{loc:Tr students.registrationFee}" />
                <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding RegistrationFee, StringFormat={}{0:0.##}}" />

                <Button Content="{loc:Tr students.openFile}"
                        Style="{StaticResource Button.Primary}"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="{StaticResource Inset.Page}">

            <!-- Header -->
            <controls:PageHeader DockPanel.Dock="Top"
                                 Breadcrumb="{loc:Tr menu.students}"
                                 Title="{loc:Tr students.title}">
                <controls:PageHeader.ActionsContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding AddCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Icon.Add}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr students.add}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ImportCsvCommand}"
                                ToolTip="{loc:Tr students.importCsv}"
                                AutomationProperties.Name="{loc:Tr students.importCsv}"
                                Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Csv}" />
                        </Button>
                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ImportExcelCommand}"
                                ToolTip="{loc:Tr students.importExcel}"
                                AutomationProperties.Name="{loc:Tr students.importExcel}"
                                Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Excel}" />
                        </Button>

                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ExportCsvCommand}"
                                ToolTip="{loc:Tr students.exportCsv}"
                                AutomationProperties.Name="{loc:Tr students.exportCsv}"
                                Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Export}" behaviors:RtlMirrorBehavior.IsEnabled="True" />
                        </Button>
                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ExportExcelCommand}"
                                ToolTip="{loc:Tr students.exportExcel}"
                                AutomationProperties.Name="{loc:Tr students.exportExcel}"
                                Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Excel}" />
                        </Button>

                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding OpenQrPrintCommand}"
                                ToolTip="{loc:Tr students.printQrCodes}"
                                AutomationProperties.Name="{loc:Tr students.printQrCodes}"
                                Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Qr}" />
                        </Button>

                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ReloadCommand}"
                                ToolTip="{loc:Tr common.refresh}"
                                AutomationProperties.Name="{loc:Tr common.refresh}">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Refresh}" />
                        </Button>
                    </StackPanel>
                </controls:PageHeader.ActionsContent>
            </controls:PageHeader>

            <!-- Filter bar -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Component.Card}"
                    Padding="{StaticResource Inset.Card.Compact}"
                    Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:SearchBox Grid.Column="0"
                                            Placeholder="{loc:Tr students.searchHint}"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            SearchCommand="{Binding SearchCommand}" />

                        <ComboBox Grid.Column="1"
                                  Width="140"
                                  Margin="8,0,0,0"
                                  ToolTip="{loc:Tr students.filterLevel}"
                                  AutomationProperties.Name="{loc:Tr students.filterLevel}"
                                  ItemsSource="{Binding Levels}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" />

                        <ComboBox Grid.Column="2"
                                  Width="140"
                                  Margin="8,0,0,0"
                                  ToolTip="{loc:Tr students.filterGrade}"
                                  AutomationProperties.Name="{loc:Tr students.filterGrade}"
                                  ItemsSource="{Binding Grades}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedGrade, Mode=TwoWay}" />

                        <ComboBox Grid.Column="3"
                                  Width="140"
                                  Margin="8,0,0,0"
                                  ToolTip="{loc:Tr students.filterGroup}"
                                  AutomationProperties.Name="{loc:Tr students.filterGroup}"
                                  ItemsSource="{Binding Groups}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />

                        <ComboBox Grid.Column="4"
                                  Width="130"
                                  Margin="8,0,0,0"
                                  ToolTip="{loc:Tr students.filterStatus}"
                                  AutomationProperties.Name="{loc:Tr students.filterStatus}"
                                  ItemsSource="{Binding Statuses}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />

                        <ComboBox Grid.Column="5"
                                  Width="140"
                                  Margin="8,0,0,0"
                                  ToolTip="{loc:Tr common.sortBy}"
                                  AutomationProperties.Name="{loc:Tr common.sortBy}"
                                  ItemsSource="{Binding SortOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />

                        <Button Grid.Column="6"
                                Style="{StaticResource Button.Subtle}"
                                Margin="8,0,0,0"
                                Command="{Binding ReloadCommand}"
                                ToolTip="{loc:Tr common.sortDescending}"
                                AutomationProperties.Name="{loc:Tr common.sortDescending}">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Sort}" />
                        </Button>

                        <CheckBox Grid.Column="7"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding SortDescending, Mode=TwoWay}"
                                  Content="{loc:Tr common.sortDescending}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <CheckBox Margin="0,0,16,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding FeePendingOnly, Mode=TwoWay}"
                                      Content="{loc:Tr students.feePendingFilter}" />

                            <ItemsControl ItemsSource="{Binding ActiveFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:Chip Text="{Binding Label}"
                                                       Tone="Accent"
                                                       ShowClose="True"
                                                       Margin="0,0,6,0"
                                                       CloseCommand="{Binding DataContext.ClearFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Kind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="{loc:Tr students.clearFilters}"
                                    Style="{StaticResource Button.Link}"
                                    Command="{Binding ClearFiltersCommand}"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Subtle}"
                                    Command="{Binding ShowTableCommand}"
                                    ToolTip="{loc:Tr students.viewTable}"
                                    AutomationProperties.Name="{loc:Tr students.viewTable}"
                                    Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.List}" />
                            </Button>
                            <Button Style="{StaticResource Button.Subtle}"
                                    Command="{Binding ShowCardsCommand}"
                                    ToolTip="{loc:Tr students.viewCards}"
                                    AutomationProperties.Name="{loc:Tr students.viewCards}">
                                <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Grid}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Banners -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Banner.Danger}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:Tr license.renewNow}"
                            Command="{Binding RenewLicenseCommand}"
                            Style="{StaticResource Button.Link}"
                            Margin="12,0,0,0"
                            Visibility="{Binding IsRenewVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Banner.Success}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Table -->
            <controls:DataTable Margin="0,16,0,0"
                                Visibility="{Binding IsTableView, Converter={StaticResource BoolToVisibility}}"
                                ItemsSource="{Binding Items}"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                SelectedItems="{Binding SelectedRows, Mode=OneWayToSource}"
                                ItemActivatedCommand="{Binding DetailsCommand}"
                                EditCommand="{Binding EditSelectedCommand}"
                                DeleteCommand="{Binding DeleteSelectedCommand}"
                                AddCommand="{Binding AddCommand}"
                                RefreshCommand="{Binding ReloadCommand}"
                                ShowSearch="False"
                                ShowDetailPanel="True"
                                DetailTemplate="{StaticResource Students.QuickProfile}"
                                EmptyTitle="{loc:Tr students.empty}"
                                EmptyDescription="{loc:Tr students.emptyHint}"
                                EmptyActionText="{loc:Tr students.add}"
                                EmptyActionCommand="{Binding AddCommand}"
                                EmptyGlyph="{StaticResource Icon.Students}">
                <controls:DataTable.BulkActionsContent>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Text="{Binding SelectedCountText}" />
                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding PrintSelectedQrCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Icon.Qr}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr students.bulkQr}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding MessageGuardiansCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Icon.Message}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr students.bulkMessage}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:DataTable.BulkActionsContent>
                <controls:DataTable.Columns>
                    <controls:DataTableColumn Header="{loc:Tr students.studentCode}"
                                              BindingPath="StudentCode"
                                              Width="120" />
                    <controls:DataTableColumn Header="{loc:Tr students.firstName}"
                                              BindingPath="FirstName"
                                              Width="*" />
                    <controls:DataTableColumn Header="{loc:Tr students.lastName}"
                                              BindingPath="LastName"
                                              Width="*" />
                    <controls:DataTableColumn Header="{loc:Tr students.filterLevel}"
                                              BindingPath="LevelName"
                                              Width="110" />
                    <controls:DataTableColumn Header="{loc:Tr students.filterGroup}"
                                              BindingPath="GroupNames"
                                              Width="130" />
                    <controls:DataTableColumn Header="{loc:Tr students.guardianName}"
                                              BindingPath="GuardianName"
                                              Width="140" />
                    <controls:DataTableColumn Header="{loc:Tr students.registrationFee}"
                                              BindingPath="RegistrationFee"
                                              Width="110"
                                              IsNumeric="True"
                                              StringFormat="{}{0:0.##}" />
                    <controls:DataTableColumn Header="{loc:Tr students.filterStatus}"
                                              BindingPath="Status"
                                              Width="110"
                                              CellTemplate="{StaticResource Students.StatusCell}" />
                </controls:DataTable.Columns>
            </controls:DataTable>

            <!-- Cards -->
            <ListBox Margin="0,16,0,0"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="{Binding IsCardView, Converter={StaticResource BoolToVisibility}}"
                     ItemsSource="{Binding Cards}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Component.Card}"
                                Padding="{StaticResource Inset.Card.Compact}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:Avatar Grid.Column="0"
                                                 DisplayName="{Binding FullName}"
                                                 Initials="{Binding Initials}"
                                                 Tone="{Binding StatusTone}"
                                                 Size="44"
                                                 Margin="0,0,12,0"
                                                 VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.BodyStrong}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding FullName}" />
                                    <TextBlock Style="{StaticResource Component.Hint}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Placement}" />
                                    <TextBlock Style="{StaticResource Component.Hint}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding GuardianText}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Margin="12,0"
                                            HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource Text.Numeric}"
                                               HorizontalAlignment="Right"
                                               Text="{Binding FeeText}" />
                                    <TextBlock Style="{StaticResource Component.Hint}"
                                               HorizontalAlignment="Right"
                                               Text="{loc:Tr students.registrationFee}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <controls:StatusBadge Text="{Binding StatusText}"
                                                          Tone="{Binding StatusTone}"
                                                          ShowDot="True"
                                                          HorizontalAlignment="Right" />
                                    <Button Content="{loc:Tr students.openFile}"
                                            Style="{StaticResource Button.Link}"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0"
                                            Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Item}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Shared add/edit form, in a D3 side panel -->
        <controls:SidePanel IsOpen="{Binding IsEditorOpen, Mode=TwoWay}"
                            Title="{Binding EditorTitle}"
                            PanelWidth="480"
                            CloseCommand="{Binding CancelEditorCommand}">
            <controls:SidePanel.PanelContent>
                <views:StudentFormView DataContext="{Binding}" />
            </controls:SidePanel.PanelContent>
            <controls:SidePanel.ActionsContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr common.cancel}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding CancelEditorCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:Tr common.save}"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveEditorCommand}" />
                </StackPanel>
            </controls:SidePanel.ActionsContent>
        </controls:SidePanel>

        <!-- Import report -->
        <Border Style="{StaticResource EditorOverlay}"
                Panel.ZIndex="20"
                Visibility="{Binding IsImportReportOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource EditorCard}">
                <StackPanel>
                    <TextBlock Text="{Binding ImportReportTitle}"
                               Style="{StaticResource Component.SectionTitle}" />
                    <TextBlock Text="{Binding ImportReportSummary}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,4,0,12" />

                    <DataGrid ItemsSource="{Binding ImportErrors}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False"
                              MaxHeight="360"
                              MinWidth="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr students.importReport}"
                                                Binding="{Binding Row}"
                                                Width="120" />
                            <DataGridTextColumn Header="{loc:Tr students.fullName}"
                                                Binding="{Binding Reference}"
                                                Width="*" />
                            <DataGridTextColumn Header="{loc:Tr common.error}"
                                                Binding="{Binding Message}"
                                                Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Content="{loc:Tr common.close}"
                                Command="{Binding CloseImportReportCommand}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
