<UserControl x:Class="SchoolManagement.Desktop.Views.ToastHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:behaviors="clr-namespace:SchoolManagement.Desktop.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=False}"
             IsHitTestVisible="True">

    <!-- =====================================================================
         Phase D2 - non-blocking toasts. They sit above the page content, never
         take focus, and are capped by ToastService so a burst cannot grow the
         visual tree without bound.
         ===================================================================== -->

    <ItemsControl ItemsSource="{Binding Toasts.Items}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,24,24"
                  MaxWidth="380">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ToastItem}">
                <Border MinWidth="260"
                        Margin="0,8,0,0"
                        Padding="12,10"
                        CornerRadius="{StaticResource Radius.Card}"
                        BorderThickness="1"
                        Effect="{StaticResource Shadow.Md}"
                        behaviors:MotionBehavior.Play="SlideUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Info.Container}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Info}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                    <Setter Property="Background" Value="{DynamicResource Success.Container}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource Warning.Container}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                    <Setter Property="Background" Value="{DynamicResource Danger.Container}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontFamily="{StaticResource Font.Family.Icons}"
                                   FontSize="16"
                                   VerticalAlignment="Top"
                                   Margin="0,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{StaticResource Icon.Info}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Info.OnContainer}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Success">
                                            <Setter Property="Text" Value="{StaticResource Icon.Completed}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Success.OnContainer}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Warning.OnContainer}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                            <Setter Property="Text" Value="{StaticResource Icon.Error}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Danger.OnContainer}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   Margin="10,0,8,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Foreground" Value="{DynamicResource Info.OnContainer}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Success">
                                            <Setter Property="Foreground" Value="{DynamicResource Success.OnContainer}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter Property="Foreground" Value="{DynamicResource Warning.OnContainer}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                            <Setter Property="Foreground" Value="{DynamicResource Danger.OnContainer}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="2"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource Button.Icon}"
                                Width="24"
                                Height="24"
                                ToolTip="{loc:Tr toast.dismiss}"
                                AutomationProperties.Name="{loc:Tr toast.dismiss}">
                            <TextBlock Text="{StaticResource Icon.Close}"
                                       FontFamily="{StaticResource Font.Family.Icons}"
                                       FontSize="12" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
