<UserControl x:Class="SchoolManagement.Desktop.Views.TakeAttendancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F9" Command="{Binding ScanQrCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetAllPresentCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetAllAbsentCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SetAllLateCommand}" />
    </UserControl.InputBindings>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr common.back}"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource LinkButton}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                    <TextBlock Text="{loc:Tr attendance.takeAttendance}"
                               Style="{StaticResource PageTitle}" />
                </StackPanel>
                <Button Content="{loc:Tr common.refresh}"
                        Command="{Binding ReloadCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GroupName}"
                                   Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding DateText}"
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TimeText}"
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TypeText}"
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TopicText}"
                               Style="{StaticResource PageSubtitle}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{loc:Tr attendance.sessionClosed}"
                               Foreground="{DynamicResource Brush.Warning}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{Binding PresentCountText}"
                           Foreground="{DynamicResource Brush.Present}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding AbsentCountText}"
                           Foreground="{DynamicResource Brush.Danger}"
                           FontWeight="SemiBold"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding LateCountText}"
                           Foreground="{DynamicResource Brush.Late}"
                           FontWeight="SemiBold"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalCountText}"
                           Style="{StaticResource PageSubtitle}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr attendance.setAllPresent}"
                            Command="{Binding SetAllPresentCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="{loc:Tr attendance.setAllAbsent}"
                            Command="{Binding SetAllAbsentCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                    <Button Content="{loc:Tr attendance.setAllLate}"
                            Command="{Binding SetAllLateCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                    <Button Content="{loc:Tr attendance.scanQr}"
                            Command="{Binding ScanQrCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>
                <Button Content="{loc:Tr attendance.saveAttendance}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>

            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Brush.Danger}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:Tr license.renewNow}"
                            Command="{Binding RenewLicenseCommand}"
                            Style="{StaticResource LinkButton}"
                            Margin="12,0,0,0"
                            Visibility="{Binding IsRenewVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource Brush.Success}"
                       Margin="0,12,0,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                    Visibility="{Binding HasDueHomeworks, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr attendance.homeworksDue}"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding DueHomeworks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DueText}"
                                               Style="{StaticResource PageSubtitle}"
                                               Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding CountsText}"
                                               Style="{StaticResource PageSubtitle}"
                                               Margin="12,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  Margin="0,14,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr students.studentCode}"
                                    Binding="{Binding StudentCode}"
                                    Width="120" />
                <DataGridTextColumn Header="{loc:Tr students.fullName}"
                                    Binding="{Binding StudentName}"
                                    Width="*" />
                <DataGridTextColumn Header="{loc:Tr common.status}"
                                    Binding="{Binding StatusText}"
                                    Width="110" />
                <DataGridTemplateColumn Header="{loc:Tr common.actions}" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Tr attendance.present}"
                                        Style="{StaticResource LinkButton}"
                                        Foreground="{DynamicResource Brush.Present}"
                                        Command="{Binding MarkPresentCommand}" />
                                <Button Content="{loc:Tr attendance.absent}"
                                        Style="{StaticResource LinkButton}"
                                        Foreground="{DynamicResource Brush.Danger}"
                                        Command="{Binding MarkAbsentCommand}"
                                        Margin="8,0,0,0" />
                                <Button Content="{loc:Tr attendance.late}"
                                        Style="{StaticResource LinkButton}"
                                        Foreground="{DynamicResource Brush.Late}"
                                        Command="{Binding MarkLateCommand}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
