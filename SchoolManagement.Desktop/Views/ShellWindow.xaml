<Window x:Class="SchoolManagement.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
        xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
        xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
        Title="{loc:Tr app.name}"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
            <views:StudentsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
            <views:GroupsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinancePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.NavRail}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="22,26,22,18">
                        <TextBlock Text="{loc:Tr app.name}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Tr app.subtitle}"
                                   Style="{StaticResource PageSubtitle}"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavRailItem}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}"
                                               Style="{StaticResource NavGlyph}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               Style="{StaticResource NavLabel}"
                                               Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource Brush.Background}">
                <ContentControl Content="{Binding CurrentViewModel}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>

        <views:StatusBarView Grid.Row="1" />
    </Grid>
</Window>
