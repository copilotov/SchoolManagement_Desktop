<ui:FluentWindow x:Class="SchoolManagement.Desktop.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
                 xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
                 xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=False}"
                 Title="{loc:Tr app.name}"
                 Width="1280"
                 Height="820"
                 MinWidth="1000"
                 MinHeight="650"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 FlowDirection="{Binding FlowDirection}">

    <ui:FluentWindow.Resources>
        <!-- One template per destination. The shell keeps the created view alive
             (see ShellWindow.xaml.cs), so scroll position and inline editor state
             survive a round trip to another destination. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
            <views:StudentsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentDetailsViewModel}">
            <views:StudentDetailsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentCardViewModel}">
            <views:StudentCardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsQrPrintViewModel}">
            <views:StudentsQrPrintPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
            <views:GroupsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupDetailsViewModel}">
            <views:GroupDetailsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupScheduleViewModel}">
            <views:GroupSchedulePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EnrollmentViewModel}">
            <views:EnrollmentPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimetableViewModel}">
            <views:TimetablePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupFullReportViewModel}">
            <views:GroupFullReportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
            <views:AttendancePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TakeAttendanceViewModel}">
            <views:TakeAttendancePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeworkViewModel}">
            <views:HomeworkReportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceReportViewModel}">
            <views:AttendanceReportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcademicsViewModel}">
            <views:AcademicsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinancePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
            <views:NotificationsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MessagesViewModel}">
            <views:MessagesPage />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: school name + app name + window buttons -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding SchoolName}"
                     Header="{loc:Tr app.name}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:FontIcon Glyph="&#xE80F;" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding NavColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:NavRailView Grid.Column="0" />

            <Grid Grid.Column="1" Background="{DynamicResource Surface.Base}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page top bar: back, breadcrumb, contextual new, search, help -->
                <Border Grid.Row="0"
                        Padding="16,10,16,6"
                        Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding GoBackCommand}"
                                Style="{StaticResource Button.Icon}"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,4,0"
                                ToolTip="{loc:Tr shell.back}"
                                AutomationProperties.Name="{loc:Tr shell.back}">
                            <TextBlock Text="{StaticResource Icon.Back}"
                                       FontFamily="{StaticResource Font.Family.Icons}"
                                       FontSize="16" />
                        </Button>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0">
                            <TextBlock Text="{Binding CurrentGroupLabel}"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentPageTitle}"
                                       Style="{StaticResource Text.Subtitle}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Command="{Binding ExecuteNewShortcutCommand}"
                                Style="{StaticResource Button.Icon}"
                                Margin="8,0"
                                ToolTip="{loc:Tr shortcuts.new}"
                                AutomationProperties.Name="{loc:Tr shortcuts.new}">
                            <TextBlock Text="{StaticResource Icon.Add}"
                                       FontFamily="{StaticResource Font.Family.Icons}"
                                       FontSize="16" />
                        </Button>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Command="{Binding OpenCommandPaletteCommand}"
                                    Style="{StaticResource ShellSearchButton}"
                                    Width="240"
                                    Margin="0,0,8,0"
                                    ToolTip="{loc:Tr shell.search}"
                                    AutomationProperties.Name="{loc:Tr shell.search}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{StaticResource Icon.Search}"
                                               FontFamily="{StaticResource Font.Family.Icons}"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Tr shell.search}"
                                               Style="{StaticResource Text.BodySmall}"
                                               Margin="8,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Style="{StaticResource KeyCap}">
                                        <TextBlock Text="{loc:Tr shortcuts.keysSearch}"
                                                   Style="{StaticResource KeyCapText}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Command="{Binding OpenShortcutsCommand}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="{loc:Tr shell.help}"
                                    AutomationProperties.Name="{loc:Tr shell.help}">
                                <TextBlock Text="{StaticResource Icon.Help}"
                                           FontFamily="{StaticResource Font.Family.Icons}"
                                           FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- License banner: above the content, never over it -->
                <views:LicenseBannerView Grid.Row="1"
                                         DataContext="{Binding License}" />

                <!-- Page host: one cached view per ViewModel -->
                <Grid x:Name="PageHost" Grid.Row="2" />

                <!-- Overlays -->
                <views:CommandPaletteView Grid.Row="0"
                                          Grid.RowSpan="3"
                                          Panel.ZIndex="20"
                                          DataContext="{Binding CommandPalette}" />
                <views:ToastHostView Grid.Row="0"
                                     Grid.RowSpan="3"
                                     Panel.ZIndex="10" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
