<UserControl x:Class="SchoolManagement.Desktop.Views.GroupDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr common.back}"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource LinkButton}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource PageTitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{loc:Tr common.edit}"
                            Command="{Binding EditCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="{loc:Tr groups.manageStudents}"
                            Command="{Binding EnrollCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                    <Button Content="{loc:Tr groups.schedule}"
                            Command="{Binding ScheduleCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                    <Button Content="{loc:Tr groups.fullReport}"
                            Command="{Binding ReportCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                        <TextBlock Text="{Binding GroupName}"
                                   Style="{StaticResource SectionHeader}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Tr groups.capacity}"
                                       Style="{StaticResource PageSubtitle}" />
                            <TextBlock Text=": "
                                       Style="{StaticResource PageSubtitle}" />
                            <TextBlock Text="{Binding CapacityText}"
                                       Style="{StaticResource PageSubtitle}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <ProgressBar Value="{Binding CapacityPercent}"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,8">
                        <TextBlock Text="{loc:Tr groups.subject}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SubjectText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                        <TextBlock Text="{loc:Tr groups.teacher}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding TeacherText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,8">
                        <TextBlock Text="{loc:Tr groups.grade}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding GradeText}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,8">
                        <TextBlock Text="{loc:Tr levels.title}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding LevelText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,8">
                        <TextBlock Text="{loc:Tr groups.monthlyFee}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding FeeText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,12,8">
                        <TextBlock Text="{loc:Tr groups.studentsCount}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding CapacityText}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="{loc:Tr reports.attendanceSummary}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding AttendanceText}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <TabControl Margin="0,14,0,0">
            <TabItem Header="{loc:Tr groups.enrolledStudents}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Students}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr students.sortCode}"
                                                Binding="{Binding StudentCode}"
                                                Width="130" />
                            <DataGridTextColumn Header="{loc:Tr students.fullName}"
                                                Binding="{Binding StudentName}"
                                                Width="*" />
                            <DataGridTextColumn Header="{loc:Tr groups.enrollmentDate}"
                                                Binding="{Binding EnrollmentDate}"
                                                Width="160" />
                            <DataGridTextColumn Header="{loc:Tr common.status}"
                                                Binding="{Binding Status}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{loc:Tr enrollment.noStudents}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStudents}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Tr groups.weeklySchedule}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Slots}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr groups.dayOfWeek}"
                                                Binding="{Binding DayOfWeek}"
                                                Width="100" />
                            <DataGridTextColumn Header="{loc:Tr groups.startTime}"
                                                Binding="{Binding StartTime, StringFormat={}{0:HH:mm}}"
                                                Width="100" />
                            <DataGridTextColumn Header="{loc:Tr groups.endTime}"
                                                Binding="{Binding EndTime, StringFormat={}{0:HH:mm}}"
                                                Width="100" />
                            <DataGridTextColumn Header="{loc:Tr groups.location}"
                                                Binding="{Binding Location}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{loc:Tr groups.noSchedule}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSlots}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Tr reports.attendanceSummary}">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding AttendanceText}"
                                   Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{loc:Tr students.attendanceTabEmpty}"
                                   Style="{StaticResource PageSubtitle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
