<UserControl x:Class="SchoolManagement.Desktop.Views.GroupDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:behaviors="clr-namespace:SchoolManagement.Desktop.Behaviors"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GroupDetailsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="900"
             d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D5 - the group file.

         A header card carries the identity, the capacity meter and the
         attendance rate; three tabs hold the roster, the compact weekly
         timetable and the attendance shortcuts. Nothing here writes: every
         action opens an existing screen.
         ===================================================================== -->

    <DockPanel Margin="{StaticResource Inset.Page}">

        <controls:PageHeader DockPanel.Dock="Top"
                             Breadcrumb="{loc:Tr menu.groups}"
                             Title="{Binding Title}"
                             Description="{Binding GroupName}">
            <controls:PageHeader.ActionsContent>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Subtle}"
                            Command="{Binding BackCommand}"
                            ToolTip="{loc:Tr common.back}"
                            AutomationProperties.Name="{loc:Tr common.back}"
                            Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Back}" behaviors:RtlMirrorBehavior.IsEnabled="True" />
                    </Button>

                    <Button Content="{loc:Tr common.edit}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding EditCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:Tr groups.manageStudents}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding EnrollCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:Tr groups.schedule}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ScheduleCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:Tr groups.fullReport}"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding ReportCommand}" />
                </StackPanel>
            </controls:PageHeader.ActionsContent>
        </controls:PageHeader>

        <Border DockPanel.Dock="Top"
                Style="{StaticResource Banner.Danger}"
                Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Identity + capacity -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource Component.Card}"
                Padding="{StaticResource Inset.Card}"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <controls:Avatar Grid.Column="0"
                                 DisplayName="{Binding GroupName}"
                                 Tone="{Binding StatusTone}"
                                 Size="56"
                                 VerticalAlignment="Top"
                                 Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Subtitle}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding GroupName}" />
                        <controls:StatusBadge Text="{Binding StatusText}"
                                              Tone="{Binding StatusTone}"
                                              ShowDot="True"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr groups.subject}" />
                            <TextBlock Style="{StaticResource Text.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SubjectText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr groups.teacher}" />
                            <TextBlock Style="{StaticResource Text.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding TeacherText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr groups.grade}" />
                            <TextBlock Style="{StaticResource Text.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding GradeText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr levels.title}" />
                            <TextBlock Style="{StaticResource Text.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding LevelText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <controls:CapacityBar Current="{Binding ActiveEnrollments}"
                                          Maximum="{Binding MaxStudents}"
                                          Caption="{loc:Tr groups.capacity}"
                                          ShowValue="True" />

                    <TextBlock Style="{StaticResource Component.Hint}"
                               Margin="0,12,0,0"
                               Text="{loc:Tr reports.attendanceSummary}" />
                    <TextBlock Style="{StaticResource Text.Numeric.Large}"
                               Text="{Binding AttendanceText}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="0,16,0,0">
            <!-- Roster -->
            <TabItem Header="{loc:Tr groups.enrolledStudents}">
                <Grid Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding Students}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr students.sortCode}"
                                                Binding="{Binding StudentCode}"
                                                Width="130" />
                            <DataGridTextColumn Header="{loc:Tr students.fullName}"
                                                Binding="{Binding StudentName}"
                                                Width="*" />
                            <DataGridTextColumn Header="{loc:Tr groups.enrollmentDate}"
                                                Binding="{Binding EnrollmentDate}"
                                                Width="160" />
                            <DataGridTextColumn Header="{loc:Tr common.status}"
                                                Binding="{Binding Status}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource Text.Subtitle}"
                               Foreground="{DynamicResource Text.Secondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{loc:Tr enrollment.noStudents}"
                               Visibility="{Binding HasStudents, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </TabItem>

            <!-- Compact timetable -->
            <TabItem Header="{loc:Tr groups.compactTimetable}">
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <controls:WeekScheduleGrid Items="{Binding WeekScheduleItems}"
                                               DayLabels="{Binding DayLabels}"
                                               StartHour="8"
                                               EndHour="19"
                                               HourHeight="34"
                                               IsCompact="True"
                                               EmptyText="{loc:Tr groups.scheduleEmpty}" />
                </ScrollViewer>
            </TabItem>

            <!-- Attendance + shortcuts -->
            <TabItem Header="{loc:Tr reports.attendanceSummary}">
                <Border Style="{StaticResource Component.Card}"
                        Padding="{StaticResource Inset.Card}"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Component.SectionTitle}"
                                   Text="{loc:Tr reports.attendanceSummary}" />
                        <TextBlock Style="{StaticResource Text.Numeric.Large}"
                                   Margin="0,6,0,0"
                                   Text="{Binding AttendanceText}" />

                        <Border Style="{StaticResource Divider}" Margin="0,16" />

                        <TextBlock Style="{StaticResource Component.SectionTitle}"
                                   Text="{loc:Tr groups.shortcuts}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Button.Secondary}"
                                    Command="{Binding OpenAttendanceCommand}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon.Glyph}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{StaticResource Icon.Attendance}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr groups.openAttendance}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}"
                                    Command="{Binding OpenHomeworkCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon.Glyph}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{StaticResource Icon.Homework}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr groups.openHomework}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
