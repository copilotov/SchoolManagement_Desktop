<UserControl x:Class="SchoolManagement.Desktop.Views.StudentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StudentsViewModel, IsDesignTimeCreatable=False}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D5 - the shared student form, hosted in the list side panel.
         Required fields carry their own message under the field; the view model
         validates before the guarded write, so a blocked save keeps the form
         open with the reason already visible.
         ===================================================================== -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <controls:FormSection Title="{loc:Tr students.personalInfo}">
                <controls:FormSection.SectionContent>
                    <StackPanel>
                        <controls:FormField Label="{loc:Tr students.firstName}"
                                            IsRequired="True"
                                            ErrorText="{Binding FirstNameError}">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorFirstName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.lastName}"
                                            IsRequired="True"
                                            ErrorText="{Binding LastNameError}"
                                            Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorLastName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.studentCode}"
                                            Description="{loc:Tr students.codeHint}"
                                            Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.dateOfBirth}"
                                            Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorDateOfBirth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.gender}"
                                            Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <ComboBox ItemsSource="{Binding Genders}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedEditorGender, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>
                    </StackPanel>
                </controls:FormSection.SectionContent>
            </controls:FormSection>

            <controls:FormSection Title="{loc:Tr students.contactInfo}" Margin="0,20,0,0">
                <controls:FormSection.SectionContent>
                    <StackPanel>
                        <controls:FormField Label="{loc:Tr students.phone}">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorPhone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.address}" Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorAddress, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>
                    </StackPanel>
                </controls:FormSection.SectionContent>
            </controls:FormSection>

            <controls:FormSection Title="{loc:Tr students.additionalInfo}" Margin="0,20,0,0">
                <controls:FormSection.SectionContent>
                    <StackPanel>
                        <controls:FormField Label="{loc:Tr students.status}">
                            <controls:FormField.FieldContent>
                                <ComboBox ItemsSource="{Binding Statuses}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedEditorStatus, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.registrationFee}"
                                            ErrorText="{Binding FeeError}"
                                            Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorRegistrationFee, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.notes}" Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorNotes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="72"
                                         VerticalContentAlignment="Top" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>
                    </StackPanel>
                </controls:FormSection.SectionContent>
            </controls:FormSection>

            <controls:FormSection Title="{loc:Tr students.guardianSection}" Margin="0,20,0,0">
                <controls:FormSection.SectionContent>
                    <StackPanel>
                        <controls:FormField Label="{loc:Tr students.guardianName}"
                                            ErrorText="{Binding GuardianError}">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorGuardianName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.guardianPhone}" Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorGuardianPhone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.guardianEmail}" Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorGuardianEmail, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Label="{loc:Tr students.guardianRelationship}" Margin="0,12,0,0">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorGuardianRelationship, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>
                    </StackPanel>
                </controls:FormSection.SectionContent>
            </controls:FormSection>
        </StackPanel>
    </ScrollViewer>
</UserControl>
