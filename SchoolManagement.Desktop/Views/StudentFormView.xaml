<UserControl x:Class="SchoolManagement.Desktop.Views.StudentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <StackPanel>
        <TextBlock Text="{Binding EditorTitle}"
                   Style="{StaticResource SectionHeader}"
                   Margin="0,0,0,12" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Personal information -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                    <TextBlock Text="{loc:Tr students.personalInfo}"
                               Style="{StaticResource FieldLabel}"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr students.firstName}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="*"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   ToolTip="{loc:Tr common.required}" />
                    </StackPanel>
                    <TextBox Text="{Binding EditorFirstName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr students.lastName}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="*"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   ToolTip="{loc:Tr common.required}" />
                    </StackPanel>
                    <TextBox Text="{Binding EditorLastName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="{loc:Tr students.studentCode}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditorCode, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Tr students.codeHint}" />
                    <TextBlock Text="{loc:Tr students.codeHint}"
                               Style="{StaticResource PageSubtitle}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="{loc:Tr students.dateOfBirth}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditorDateOfBirth, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0">
                    <TextBlock Text="{loc:Tr students.gender}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Genders}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedEditorGender, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="2">
                    <TextBlock Text="{loc:Tr students.status}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Statuses}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedEditorStatus, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="{loc:Tr students.phone}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditorPhone, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="+213" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Text="{loc:Tr students.registrationFee}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditorRegistrationFee, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="3">
                    <TextBlock Text="{loc:Tr students.address}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditorAddress, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
                    <TextBlock Text="{loc:Tr students.notes}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditorNotes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <!-- Guardian -->
                <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <TextBlock Text="{loc:Tr students.guardianSection}"
                               Style="{StaticResource FieldLabel}"
                               FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{loc:Tr students.guardianName}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditorGuardianName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{loc:Tr students.guardianPhone}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditorGuardianPhone, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="+213" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="{loc:Tr students.guardianEmail}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditorGuardianEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="{loc:Tr students.guardianRelationship}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditorGuardianRelationship, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="{loc:Tr common.cancel}"
                    Command="{Binding CancelEditorCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" />
            <Button Content="{loc:Tr common.save}"
                    Command="{Binding SaveEditorCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
