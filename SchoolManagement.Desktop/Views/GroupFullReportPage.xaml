<UserControl x:Class="SchoolManagement.Desktop.Views.GroupFullReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr common.back}"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource LinkButton}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{loc:Tr students.cardPrint}"
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Content="{loc:Tr students.cardSavePdf}"
                            Command="{Binding SavePdfCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                    <Button Content="{loc:Tr common.open}"
                            Command="{Binding OpenCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <TextBlock Text="{loc:Tr groups.fullReport}"
                           Style="{StaticResource SectionHeader}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr common.loading}"
                           Style="{StaticResource PageSubtitle}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{loc:Tr groups.attendanceReport}"
                           Style="{StaticResource PageSubtitle}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{loc:Tr common.retry}"
                        Command="{Binding ReloadCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
