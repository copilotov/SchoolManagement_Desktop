<ui:FluentWindow x:Class="SchoolManagement.Desktop.Views.ConfirmationWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="480"
                 SizeToContent="Height"
                 MinHeight="220"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 UseLayoutRounding="True">

    <!-- =====================================================================
         Phase D2 - the single confirmation/information dialog.
         The public IUserDialogService contract is unchanged; only the surface is
         redesigned so a confirm dialog and the rest of the shell share one look.
         ===================================================================== -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     ShowMinimize="False"
                     ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        CornerRadius="{StaticResource Radius.Element}"
                        Background="{DynamicResource Accent.Container}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               Text="{StaticResource Icon.Info}"
                               FontFamily="{StaticResource Font.Family.Icons}"
                               FontSize="18"
                               Foreground="{DynamicResource Accent.OnContainer}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Style="{StaticResource Text.Subtitle}"
                           FontWeight="SemiBold"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>

            <TextBlock x:Name="MessageText"
                       Style="{StaticResource Text.Body}"
                       Foreground="{DynamicResource Text.Secondary}"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="CancelButton"
                        Content=""
                        IsCancel="True"
                        Style="{StaticResource Button.Secondary}"
                        MinWidth="96"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton"
                        Content=""
                        IsDefault="True"
                        Style="{StaticResource Button.Primary}"
                        MinWidth="96"
                        Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
