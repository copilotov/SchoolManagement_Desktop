<UserControl x:Class="SchoolManagement.Desktop.Views.StudentsQrPrintPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr students.qrColumns}"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox Width="80"
                              ItemsSource="{Binding ColumnOptions}"
                              SelectedItem="{Binding SelectedColumns, Mode=TwoWay}" />
                    <Button Content="{loc:Tr students.qrPrintAll}"
                            Command="{Binding PrintAllCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="12,0,0,0" />
                    <Button Content="{loc:Tr students.cardSavePdf}"
                            Command="{Binding SavePdfCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                    <Button Content="{loc:Tr students.cardClose}"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Summary}"
                       Style="{StaticResource PageSubtitle}"
                       Margin="0,6,0,0" />

            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="{loc:Tr students.qrEmpty}"
                       Style="{StaticResource PageSubtitle}"
                       Margin="0,12,0,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.SelectedColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="6">
                            <Border Width="180"
                                    Height="220"
                                    Style="{StaticResource Card}"
                                    Padding="10">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="{Binding Image}"
                                           Width="140"
                                           Height="140"
                                           Stretch="Uniform" />
                                    <TextBlock Text="{Binding FullName}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding StudentCode}"
                                               Style="{StaticResource PageSubtitle}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Viewbox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
