<UserControl x:Class="SchoolManagement.Desktop.Views.StudentsQrPrintPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StudentsQrPrintViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="900"
             d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D5 - the bulk QR sheet. Each tile keeps a Viewbox so the QR never
         clips at any column count, and the sheet itself zooms through a
         LayoutTransform. The same PDF builder feeds print and save.
         ===================================================================== -->

    <DockPanel Margin="{StaticResource Inset.Page}">
        <StackPanel DockPanel.Dock="Top">
            <controls:PageHeader Breadcrumb="{loc:Tr menu.students}"
                                 Title="{Binding Title}"
                                 Description="{Binding Summary}">
                <controls:PageHeader.ActionsContent>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr students.qrColumns}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="72"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding ColumnOptions}"
                                  SelectedItem="{Binding SelectedColumns, Mode=TwoWay}" />

                        <Button Style="{StaticResource Button.Subtle}"
                                Content="-"
                                FontSize="16"
                                Width="36"
                                Command="{Binding ZoomOutCommand}"
                                ToolTip="{loc:Tr students.zoom}"
                                AutomationProperties.Name="{loc:Tr students.zoom}"
                                Margin="0,0,4,0" />
                        <TextBlock Style="{StaticResource Text.Numeric}"
                                   MinWidth="48"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding ZoomText}" />
                        <Button Style="{StaticResource Button.Subtle}"
                                Content="+"
                                FontSize="16"
                                Width="36"
                                Command="{Binding ZoomInCommand}"
                                ToolTip="{loc:Tr students.zoom}"
                                AutomationProperties.Name="{loc:Tr students.zoom}"
                                Margin="4,0,8,0" />

                        <Button Content="{loc:Tr students.qrPrintAll}"
                                Command="{Binding PrintAllCommand}"
                                Style="{StaticResource Button.Primary}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Tr students.cardSavePdf}"
                                Command="{Binding SavePdfCommand}"
                                Style="{StaticResource Button.Secondary}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Tr students.cardClose}"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </controls:PageHeader.ActionsContent>
            </controls:PageHeader>

            <Border Style="{StaticResource Banner.Danger}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <controls:EmptyState Title="{loc:Tr students.qrEmpty}"
                                 Description="{loc:Tr students.emptyHint}"
                                 Glyph="{StaticResource Icon.Qr}"
                                 Margin="0,24,0,0"
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.SelectedColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="6">
                            <Border Width="180"
                                    Height="220"
                                    Style="{StaticResource Component.QrPaper}"
                                    Padding="10">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="{Binding Image}"
                                           Width="140"
                                           Height="140"
                                           Stretch="Uniform" />
                                    <TextBlock Text="{Binding FullName}"
                                               Style="{StaticResource Text.BodyStrong}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding StudentCode}"
                                               Style="{StaticResource Text.Numeric}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Viewbox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
