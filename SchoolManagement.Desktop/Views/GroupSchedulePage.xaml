<UserControl x:Class="SchoolManagement.Desktop.Views.GroupSchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelEditorCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SaveEditorCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <DockPanel Margin="24">
            <StackPanel DockPanel.Dock="Top">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Tr common.back}"
                                Command="{Binding BackCommand}"
                                Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="{loc:Tr groups.addTimeSlot}"
                                Command="{Binding AddSlotCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="{loc:Tr common.refresh}"
                                Command="{Binding ReloadCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GroupName}"
                                   Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding TeacherText}"
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CapacityText}"
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource Brush.SurfaceVariant}"
                        BorderBrush="{DynamicResource Brush.Danger}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Content="{loc:Tr license.renewNow}"
                                Command="{Binding RenewLicenseCommand}"
                                Style="{StaticResource LinkButton}"
                                Margin="12,0,0,0"
                                Visibility="{Binding IsRenewVisible, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush.Success}"
                           Margin="0,12,0,0"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   Style="{StaticResource SectionHeader}"
                                                   Margin="0,0,0,8" />

                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0">
                                                            <Run Text="{Binding StartTime, StringFormat={}{0:HH:mm}, Mode=OneWay}" />
                                                            <Run Text=" - " />
                                                            <Run Text="{Binding EndTime, StringFormat={}{0:HH:mm}, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Location}"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Content="{loc:Tr common.edit}"
                                                                    Style="{StaticResource LinkButton}"
                                                                    Command="{Binding DataContext.EditSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{loc:Tr common.delete}"
                                                                    Style="{StaticResource LinkButton}"
                                                                    Foreground="{DynamicResource Brush.Danger}"
                                                                    Command="{Binding DataContext.DeleteSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="8,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{loc:Tr groups.noSlotsShort}"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSlots}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}">
                        <TextBlock Text="{loc:Tr groups.scheduleEmpty}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnySlot}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- Slot editor -->
        <Border Style="{StaticResource EditorOverlay}"
                Panel.ZIndex="10"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource EditorCard}" MinWidth="420">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="{loc:Tr groups.dayOfWeek}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding WeekDays}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedDay, Mode=TwoWay}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Tr groups.startTime}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditorStartTime, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Tr groups.endTime}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditorEndTime, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Tr groups.location}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding EditorLocation, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox IsChecked="{Binding EditorIsActive, Mode=TwoWay}"
                              Content="{loc:Tr common.active}"
                              Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Content="{loc:Tr common.cancel}"
                                Command="{Binding CancelEditorCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" />
                        <Button Content="{loc:Tr common.save}"
                                Command="{Binding SaveEditorCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Conflict confirmation: conflicts warn, they never block -->
        <Border Style="{StaticResource EditorOverlay}"
                Panel.ZIndex="20"
                Visibility="{Binding IsConflictOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource EditorCard}" MinWidth="480">
                <StackPanel>
                    <TextBlock Text="{loc:Tr groups.conflictTitle}"
                               Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding ConflictMessage}"
                               Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,8" />
                    <ItemsControl ItemsSource="{Binding Conflicts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Content="{loc:Tr groups.conflictCancel}"
                                Command="{Binding CancelConflictCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" />
                        <Button Content="{loc:Tr groups.conflictProceed}"
                                Command="{Binding ConfirmConflictCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
