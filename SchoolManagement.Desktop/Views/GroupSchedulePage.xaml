<UserControl x:Class="SchoolManagement.Desktop.Views.GroupSchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:behaviors="clr-namespace:SchoolManagement.Desktop.Behaviors"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GroupScheduleViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="900"
             d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D5 - the weekly schedule of one group.

         The D3 WeekScheduleGrid is the primary surface: an empty cell click opens
         the shared editor on that hour, a double-click edits a slot, and a drop
         moves it. Every move runs the same conflict check as the editor, so a
         double booking is a coloured warning and a confirmation, never a silent
         write. The day list on the trailing side is the keyboard-friendly
         equivalent (Edit/Delete per row).
         ===================================================================== -->

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelEditorCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SaveEditorCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <DockPanel Margin="{StaticResource Inset.Page}">

            <controls:PageHeader DockPanel.Dock="Top"
                                 Breadcrumb="{loc:Tr menu.groups}"
                                 Title="{Binding Title}"
                                 Description="{Binding Subtitle}">
                <controls:PageHeader.ActionsContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding BackCommand}"
                                ToolTip="{loc:Tr groups.backToGroup}"
                                AutomationProperties.Name="{loc:Tr groups.backToGroup}"
                                Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Back}" behaviors:RtlMirrorBehavior.IsEnabled="True" />
                        </Button>

                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding AddSlotCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Icon.Add}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr groups.addTimeSlot}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding GenerateSessionsCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Icon.Calendar}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr groups.generateSessions}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ReloadCommand}"
                                ToolTip="{loc:Tr common.refresh}"
                                AutomationProperties.Name="{loc:Tr common.refresh}">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Refresh}" />
                        </Button>
                    </StackPanel>
                </controls:PageHeader.ActionsContent>
            </controls:PageHeader>

            <!-- Banners -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Banner.Danger}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:Tr license.renewNow}"
                            Command="{Binding RenewLicenseCommand}"
                            Style="{StaticResource Button.Link}"
                            Margin="12,0,0,0"
                            Visibility="{Binding IsRenewVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Banner.Success}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Group identity -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Component.Card}"
                    Padding="{StaticResource Inset.Card.Compact}"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource Text.BodyStrong}"
                               Text="{Binding GroupName}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr groups.teacher}" />
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Margin="6,0,0,0"
                                   Text="{Binding TeacherText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr groups.capacity}" />
                        <TextBlock Style="{StaticResource Text.Numeric}"
                                   Margin="6,0,0,0"
                                   Text="{Binding CapacityText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grid + day list -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                        <controls:WeekScheduleGrid x:Name="ScheduleGrid"
                                                   Items="{Binding WeekScheduleItems}"
                                                   DayLabels="{Binding DayLabels}"
                                                   StartHour="8"
                                                   EndHour="19"
                                                   HourHeight="52"
                                                   IsEditable="True"
                                                   EmptyText="{loc:Tr groups.scheduleEmpty}" />

                        <TextBlock Style="{StaticResource Component.Hint}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="{loc:Tr groups.gridHint}" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2"
                        Style="{StaticResource Component.Card}"
                        Padding="{StaticResource Inset.Card.Compact}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Component.SectionTitle}"
                                                   Text="{Binding Label}" />

                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Style="{StaticResource Text.Numeric}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="{Binding StartTime, StringFormat={}{0:HH:mm}, Mode=OneWay}" />
                                                            <Run Text=" - " />
                                                            <Run Text="{Binding EndTime, StringFormat={}{0:HH:mm}, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="1"
                                                                   Style="{StaticResource Component.Hint}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Location}" />

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Style="{StaticResource Button.Icon}"
                                                                    Command="{Binding DataContext.EditSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Tr common.edit}"
                                                                    AutomationProperties.Name="{loc:Tr common.edit}">
                                                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                                                           FontSize="12"
                                                                           Text="{StaticResource Icon.Edit}" />
                                                            </Button>
                                                            <Button Style="{StaticResource Button.Icon}"
                                                                    Margin="2,0,0,0"
                                                                    Command="{Binding DataContext.DeleteSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Tr common.delete}"
                                                                    AutomationProperties.Name="{loc:Tr common.delete}">
                                                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                                                           FontSize="12"
                                                                           Text="{StaticResource Icon.Delete}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Style="{StaticResource Component.Hint}"
                                                   Margin="0,4,0,0"
                                                   Text="{loc:Tr groups.noSlotsShort}"
                                                   Visibility="{Binding HasSlots, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Slot editor -->
        <controls:Dialog IsOpen="{Binding IsEditorOpen, Mode=TwoWay}"
                         Title="{Binding EditorTitle}"
                         PrimaryText="{loc:Tr common.save}"
                         PrimaryCommand="{Binding SaveEditorCommand}"
                         SecondaryText="{loc:Tr common.cancel}"
                         SecondaryCommand="{Binding CancelEditorCommand}"
                         CloseCommand="{Binding CancelEditorCommand}">
            <controls:Dialog.DialogContent>
                <StackPanel>
                    <controls:FormField Label="{loc:Tr groups.dayOfWeek}">
                        <controls:FormField.FieldContent>
                            <ComboBox ItemsSource="{Binding WeekDays}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedDay, Mode=TwoWay}" />
                        </controls:FormField.FieldContent>
                    </controls:FormField>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:FormField Grid.Column="0" Label="{loc:Tr groups.startTime}">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorStartTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>

                        <controls:FormField Grid.Column="2" Label="{loc:Tr groups.endTime}">
                            <controls:FormField.FieldContent>
                                <TextBox Text="{Binding EditorEndTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </controls:FormField.FieldContent>
                        </controls:FormField>
                    </Grid>

                    <controls:FormField Label="{loc:Tr groups.location}" Margin="0,12,0,0">
                        <controls:FormField.FieldContent>
                            <TextBox Text="{Binding EditorLocation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </controls:FormField.FieldContent>
                    </controls:FormField>

                    <CheckBox Margin="0,12,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding EditorIsActive, Mode=TwoWay}"
                              Content="{loc:Tr common.active}" />
                </StackPanel>
            </controls:Dialog.DialogContent>
        </controls:Dialog>

        <!-- Conflict confirmation: conflicts warn, they never block -->
        <controls:Dialog IsOpen="{Binding IsConflictOpen, Mode=TwoWay}"
                         Title="{loc:Tr groups.conflictTitle}"
                         Description="{Binding ConflictMessage}"
                         Tone="Warning"
                         PrimaryText="{loc:Tr groups.conflictProceed}"
                         PrimaryCommand="{Binding ConfirmConflictCommand}"
                         SecondaryText="{loc:Tr groups.conflictCancel}"
                         SecondaryCommand="{Binding CancelConflictCommand}"
                         CloseCommand="{Binding CancelConflictCommand}">
            <controls:Dialog.DialogContent>
                <ItemsControl ItemsSource="{Binding Conflicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,2"
                                       Text="{Binding Text}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:Dialog.DialogContent>
        </controls:Dialog>
    </Grid>
</UserControl>
