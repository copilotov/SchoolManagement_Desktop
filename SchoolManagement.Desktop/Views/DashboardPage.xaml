<UserControl x:Class="SchoolManagement.Desktop.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="{loc:Tr dashboard.title}"
                       Style="{StaticResource PageTitle}" />
            <TextBlock Text="{loc:Tr dashboard.welcome}"
                       Style="{StaticResource PageSubtitle}"
                       Margin="0,6,0,24" />

            <TextBlock Text="{loc:Tr dashboard.statistics}"
                       Style="{StaticResource SectionHeader}"
                       Margin="0,0,0,12" />

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr dashboard.studentsCount}"
                                   Style="{StaticResource PageSubtitle}" />
                        <TextBlock Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr dashboard.groupsCount}"
                                   Style="{StaticResource PageSubtitle}" />
                        <TextBlock Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr dashboard.todaySessions}"
                                   Style="{StaticResource PageSubtitle}" />
                        <TextBlock Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr dashboard.outstanding}"
                                   Style="{StaticResource PageSubtitle}" />
                        <TextBlock Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr dashboard.quickActions}"
                               Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{loc:Tr common.noData}"
                               Style="{StaticResource PageSubtitle}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
