<UserControl x:Class="SchoolManagement.Desktop.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:behaviors="clr-namespace:SchoolManagement.Desktop.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="900"
             d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D4 - the daily command center.

         The page is a pure projection of DashboardViewModel: every number,
         label, tone and navigation target is already resolved there, so this
         markup never re-derives a finance, attendance or license rule. The
         column counts come from DashboardLayout through the ViewModel and are
         refreshed from SizeChanged, which is why the grid steps 3 -> 2 -> 1
         without a horizontal scrollbar.
         ===================================================================== -->

    <UserControl.Resources>
        <!-- A whole card is one keyboard-reachable target. The template keeps
             the component's own surface and paints a focus/hover ring on top,
             so the card still looks like a D3 card and never nests two
             interactive surfaces. -->
        <Style x:Key="Dashboard.CardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border x:Name="Ring"
                                    IsHitTestVisible="False"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    BorderThickness="2"
                                    BorderBrush="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square glyph tile used by the quick actions and the session rail. -->
        <Style x:Key="Dashboard.GlyphTile" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Element}" />
            <Setter Property="Background" Value="{DynamicResource Accent.Container}" />
        </Style>

        <!-- Timeline item: time, rail, card. -->
        <DataTemplate x:Key="Dashboard.SessionTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource Text.Numeric}"
                           MinWidth="92"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{Binding TimeText}" />

                <Grid Grid.Column="1" Width="24">
                    <Border Width="2"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Border.Subtle}" />
                    <Ellipse Width="10"
                             Height="10"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource Accent}" />
                </Grid>

                <Border Grid.Column="2"
                        Style="{StaticResource Component.Card.Compact}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.BodyStrong}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding GroupName}" />

                            <WrapPanel Margin="0,6,0,0">
                                <controls:StatusBadge Text="{Binding StatusText}"
                                                      Tone="{Binding Tone}"
                                                      ShowDot="True" />
                                <controls:StatusBadge Margin="8,0,0,0"
                                                      Text="{Binding TypeText}"
                                                      Tone="Info" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding StudentsText}" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Success}"
                                       ToolTip="{loc:Tr dashboard.attendanceDone}"
                                       Text="{StaticResource Icon.Check}"
                                       Visibility="{Binding HasAttendance, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Button.Secondary}"
                                    Content="{loc:Tr dashboard.takeAttendance}"
                                    Command="{Binding DataContext.TakeAttendanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanTakeAttendance, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="{StaticResource Inset.Page}">
        <StackPanel MaxWidth="{StaticResource Page.MaxWidth}"
                    HorizontalAlignment="Stretch">

            <controls:PageHeader Breadcrumb="{loc:Tr dashboard.overview}"
                                 Title="{Binding GreetingTitle}"
                                 Description="{Binding DateText}">
                <controls:PageHeader.ActionsContent>
                    <Button Style="{StaticResource Button.Secondary}"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="{loc:Tr dashboard.refresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Glyph}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Text="{StaticResource Icon.Refresh}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{loc:Tr dashboard.refresh}" />
                        </StackPanel>
                    </Button>
                </controls:PageHeader.ActionsContent>
            </controls:PageHeader>

            <!-- First load: one spinner, never a skeleton that reflows the page. -->
            <StackPanel Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <controls:ProgressRing Width="40"
                                       Height="40"
                                       HorizontalAlignment="Center"
                                       IsIndeterminate="True" />
                <TextBlock Style="{StaticResource Text.Body}"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{loc:Tr common.loading}" />
            </StackPanel>

            <controls:ErrorState Margin="0,16,0,0"
                                 Title="{loc:Tr common.error}"
                                 Message="{Binding ErrorMessage}"
                                 RetryText="{loc:Tr common.retry}"
                                 RetryCommand="{Binding RefreshCommand}"
                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

            <!-- New school: the guide replaces the empty dashboards entirely. -->
            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Component.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Component.SectionTitle}"
                                   Text="{loc:Tr dashboard.newSchoolTitle}" />
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:Tr dashboard.newSchoolHint}" />

                        <TextBlock Style="{StaticResource Component.SectionTitle}"
                                   Margin="0,20,0,0"
                                   Text="{loc:Tr dashboard.setupTitle}" />
                        <TextBlock Style="{StaticResource Component.Hint}"
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap"
                                   Text="{loc:Tr dashboard.setupHint}" />

                        <ItemsControl ItemsSource="{Binding SetupSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Component.Card}"
                                            Width="248"
                                            Margin="0,0,12,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="{StaticResource Radius.Pill}"
                                                        Background="{DynamicResource Accent.Container}">
                                                    <TextBlock Style="{StaticResource Text.Numeric}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Accent.OnContainer}"
                                                               Text="{Binding Number}" />
                                                </Border>

                                                <controls:StatusBadge Grid.Column="1"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center"
                                                                      Text="{Binding StateText}"
                                                                      Tone="{Binding Tone}"
                                                                      ShowDot="True" />
                                            </Grid>

                                            <TextBlock Style="{StaticResource Text.BodyStrong}"
                                                       Margin="0,10,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Component.Hint}"
                                                       Margin="0,4,0,0"
                                                       Text="{Binding CountText}" />

                                            <Button Style="{StaticResource Button.Secondary}"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Left"
                                                    Content="{loc:Tr dashboard.setupOpen}"
                                                    Command="{Binding DataContext.OpenSetupStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Loaded, non-new school: the command center itself. -->
            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}">

                <!-- KPI row: one clickable card per target screen. -->
                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,-12,-4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding StatColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Dashboard.CardButton}"
                                    Margin="0,0,12,12"
                                    Command="{Binding DataContext.OpenStatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Title}">
                                <controls:StatCard Title="{Binding Title}"
                                                   Value="{Binding Value}"
                                                   Icon="{Binding Glyph}"
                                                   Trend="{Binding Trend}"
                                                   TrendText="{Binding Caption}"
                                                   SparklineValues="{Binding Sparkline}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Today's sessions: a vertical timeline with one direct action. -->
                <Border Style="{StaticResource Component.Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Component.SectionTitle}"
                                       VerticalAlignment="Center"
                                       Text="{loc:Tr dashboard.todaySessions}" />

                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Link}"
                                    Content="{loc:Tr dashboard.viewAll}"
                                    Command="{Binding OpenAttendanceCommand}" />
                        </Grid>

                        <ItemsControl Margin="0,12,0,0"
                                      ItemTemplate="{StaticResource Dashboard.SessionTemplate}"
                                      ItemsSource="{Binding Sessions}"
                                      Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}" />

                        <controls:EmptyState Title="{loc:Tr dashboard.noSessionsToday}"
                                             Description="{loc:Tr dashboard.noSessionsHint}"
                                             Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Needs your attention: prioritized, each row carries its action. -->
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource Component.SectionTitle}"
                               Margin="0,0,0,12"
                               Text="{loc:Tr dashboard.attention}" />

                    <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,0,-12,-4"
                                  Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding AttentionColumns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Component.Card}"
                                        Margin="0,0,12,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon.Glyph}"
                                                       FontSize="16"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       Text="{Binding Glyph}" />
                                            <controls:StatusBadge Text="{Binding Category}"
                                                                  Tone="{Binding Tone}"
                                                                  ShowDot="True" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource Text.BodyStrong}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource Text.Body}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Body}" />

                                        <Button Style="{StaticResource Button.Link}"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Content="{Binding ActionText}"
                                                Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Component.Card}"
                            Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Glyph}"
                                       FontSize="20"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Success}"
                                       Text="{StaticResource Icon.Check}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.BodyStrong}"
                                           Text="{loc:Tr dashboard.noAttention}" />
                                <TextBlock Style="{StaticResource Component.Hint}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Text="{loc:Tr dashboard.noAttentionHint}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Analytics: three charts, each with its own empty state. -->
                <TextBlock Style="{StaticResource Component.SectionTitle}"
                           Margin="0,20,0,12"
                           Text="{loc:Tr dashboard.analytics}" />

                <UniformGrid Columns="{Binding ChartColumns}" Margin="0,0,-12,0">
                    <controls:ChartCard Margin="0,0,12,12"
                                        Kind="Bar"
                                        Tone="Success"
                                        Title="{loc:Tr dashboard.revenueTrend}"
                                        Description="{loc:Tr dashboard.revenueTrendHint}"
                                        Summary="{Binding RevenueSummary}"
                                        Values="{Binding RevenueValues}"
                                        Labels="{Binding RevenueLabels}"
                                        EmptyText="{loc:Tr dashboard.noChartData}" />

                    <controls:ChartCard Margin="0,0,12,12"
                                        Kind="Line"
                                        Tone="Info"
                                        Title="{loc:Tr dashboard.weeklyAttendance}"
                                        Description="{loc:Tr dashboard.weeklyAttendanceHint}"
                                        Summary="{Binding WeekAttendanceSummary}"
                                        Values="{Binding WeekAttendanceValues}"
                                        Labels="{Binding WeekAttendanceLabels}"
                                        EmptyText="{loc:Tr dashboard.noChartData}" />

                    <controls:ChartCard Margin="0,0,12,12"
                                        Kind="Bar"
                                        Tone="Accent"
                                        Title="{loc:Tr dashboard.levelDistribution}"
                                        Description="{loc:Tr dashboard.levelDistributionHint}"
                                        Summary="{Binding LevelSummary}"
                                        Values="{Binding LevelValues}"
                                        Labels="{Binding LevelLabels}"
                                        EmptyText="{loc:Tr dashboard.noChartData}" />
                </UniformGrid>

                <!-- Quick actions: four responsive cards, 4 -> 2 -> 1. -->
                <TextBlock Style="{StaticResource Component.SectionTitle}"
                           Margin="0,12,0,12"
                           Text="{loc:Tr dashboard.quickActions}" />

                <ItemsControl ItemsSource="{Binding QuickActions}" Margin="0,0,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding QuickColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Dashboard.CardButton}"
                                    Margin="0,0,12,12"
                                    Command="{Binding DataContext.OpenQuickActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Title}">
                                <Border Style="{StaticResource Component.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource Dashboard.GlyphTile}">
                                            <TextBlock Style="{StaticResource Icon.Glyph}"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Accent.OnContainer}"
                                                       Text="{Binding Glyph}" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Component.Hint}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Hint}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource Icon.Glyph}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{StaticResource Icon.ChevronRight}"
                                                   behaviors:RtlMirrorBehavior.IsEnabled="True" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
