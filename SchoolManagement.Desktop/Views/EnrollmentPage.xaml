<UserControl x:Class="SchoolManagement.Desktop.Views.EnrollmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:behaviors="clr-namespace:SchoolManagement.Desktop.Behaviors"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EnrollmentViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="900"
             d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D5 - the enrollment board of one group.

         The identity card carries the capacity meter and the designed warning;
         the search-and-add column lists the students who can still join, the
         roster column lists the active enrollments. A full group asks for a
         confirmation, it never blocks: the capacity policy is a warning.
         ===================================================================== -->

    <DockPanel Margin="{StaticResource Inset.Page}">

        <controls:PageHeader DockPanel.Dock="Top"
                             Breadcrumb="{loc:Tr menu.groups}"
                             Title="{Binding Title}"
                             Description="{Binding GroupName}">
            <controls:PageHeader.ActionsContent>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Subtle}"
                            Command="{Binding BackCommand}"
                            ToolTip="{loc:Tr common.back}"
                            AutomationProperties.Name="{loc:Tr common.back}"
                            Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Back}" behaviors:RtlMirrorBehavior.IsEnabled="True" />
                    </Button>

                    <Button Style="{StaticResource Button.Secondary}"
                            Command="{Binding ReloadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Glyph}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{StaticResource Icon.Refresh}" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{loc:Tr common.refresh}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader.ActionsContent>
        </controls:PageHeader>

        <!-- Identity + capacity -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource Component.Card}"
                Padding="{StaticResource Inset.Card}"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <controls:Avatar Grid.Column="0"
                                 DisplayName="{Binding GroupName}"
                                 Tone="Accent"
                                 Size="56"
                                 VerticalAlignment="Top"
                                 Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Subtitle}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding GroupName}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr groups.subject}" />
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Margin="6,0,16,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SubjectText}" />
                        <TextBlock Style="{StaticResource Component.Hint}" Text="{loc:Tr groups.teacher}" />
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding TeacherText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <controls:CapacityBar Current="{Binding Group.ActiveEnrollments}"
                                          Maximum="{Binding Group.MaxStudents}"
                                          Caption="{loc:Tr groups.capacity}"
                                          ShowValue="True" />
                    <TextBlock Style="{StaticResource Component.Hint}"
                               Margin="0,6,0,0"
                               Text="{Binding CapacityWarningText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Designed capacity warning: advisory, never a block -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource Banner.Warning}"
                Margin="0,12,0,0"
                Visibility="{Binding ShowCapacityWarning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon.Glyph}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Text="{StaticResource Icon.Warning}" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding CapacityFullText}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Style="{StaticResource Banner.Danger}"
                Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Content="{loc:Tr license.renewNow}"
                        Command="{Binding RenewLicenseCommand}"
                        Style="{StaticResource Button.Link}"
                        Margin="12,0,0,0"
                        Visibility="{Binding IsRenewVisible, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Style="{StaticResource Banner.Success}"
                Margin="0,12,0,0"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search-and-add -->
            <Border Grid.Column="0"
                    Style="{StaticResource Component.Card}"
                    Padding="{StaticResource Inset.Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Component.SectionTitle}"
                                   Text="{loc:Tr enrollment.quickAdd}" />
                        <TextBlock Style="{StaticResource Component.Hint}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{loc:Tr enrollment.availableHint}" />

                        <controls:SearchBox Margin="0,10,0,0"
                                            Placeholder="{loc:Tr enrollment.searchPlaceholder}"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            SearchCommand="{Binding SearchCommand}" />
                    </StackPanel>

                    <Grid>
                        <DataGrid ItemsSource="{Binding Available}"
                                  SelectedItem="{Binding SelectedAvailable, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr students.sortCode}"
                                                    Binding="{Binding StudentCode}"
                                                    Width="120" />
                                <DataGridTextColumn Header="{loc:Tr students.firstName}"
                                                    Binding="{Binding FirstName}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{loc:Tr students.lastName}"
                                                    Binding="{Binding LastName}"
                                                    Width="*" />
                                <DataGridTemplateColumn Header="{loc:Tr common.actions}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Tr enrollment.enroll}"
                                                    Style="{StaticResource Button.Link}"
                                                    Command="{Binding DataContext.EnrollCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyState Title="{loc:Tr enrollment.noResults}"
                                             Description="{loc:Tr enrollment.availableHint}"
                                             Glyph="{StaticResource Icon.Students}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding HasAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Roster -->
            <Border Grid.Column="2"
                    Style="{StaticResource Component.Card}"
                    Padding="{StaticResource Inset.Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource Component.SectionTitle}"
                               Margin="0,0,0,10"
                               Text="{loc:Tr enrollment.enrolledStudents}" />

                    <Grid>
                        <DataGrid ItemsSource="{Binding Enrolled}"
                                  SelectedItem="{Binding SelectedEnrolled, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr students.sortCode}"
                                                    Binding="{Binding StudentCode}"
                                                    Width="120" />
                                <DataGridTextColumn Header="{loc:Tr students.fullName}"
                                                    Binding="{Binding StudentName}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{loc:Tr enrollment.enrollDate}"
                                                    Binding="{Binding EnrollmentDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                    Width="120" />
                                <DataGridTemplateColumn Header="{loc:Tr common.actions}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Tr enrollment.unenroll}"
                                                    Style="{StaticResource Button.Link}"
                                                    Foreground="{DynamicResource Danger}"
                                                    Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyState Title="{loc:Tr enrollment.noStudents}"
                                             Description="{loc:Tr enrollment.availableHint}"
                                             Glyph="{StaticResource Icon.Groups}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding HasEnrolled, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
