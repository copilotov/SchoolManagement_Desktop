<UserControl x:Class="SchoolManagement.Desktop.Views.EnrollmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr common.back}"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource LinkButton}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                </StackPanel>
                <Button Content="{loc:Tr common.refresh}"
                        Command="{Binding ReloadCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GroupName}"
                                   Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding SubjectText}"
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TeacherText}"
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CapacityText}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <ProgressBar Value="{Binding CapacityPercent}"
                                 Maximum="100"
                                 Height="8"
                                 Margin="0,6,0,0" />
                    <TextBlock Text="{loc:Tr groups.full}"
                               Foreground="{DynamicResource Brush.Danger}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               Visibility="{Binding IsFull, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Brush.Danger}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:Tr license.renewNow}"
                            Command="{Binding RenewLicenseCommand}"
                            Style="{StaticResource LinkButton}"
                            Margin="12,0,0,0"
                            Visibility="{Binding IsRenewVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource Brush.Success}"
                       Margin="0,12,0,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{loc:Tr enrollment.searchStudent}"
                     MaxWidth="320"
                     HorizontalAlignment="Left"
                     MinWidth="240"
                     Margin="0,12,0,0" />
        </StackPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Tr enrollment.availableStudents}"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,8" />
                    <Grid>
                        <DataGrid ItemsSource="{Binding Available}"
                                  SelectedItem="{Binding SelectedAvailable, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr students.sortCode}"
                                                    Binding="{Binding StudentCode}"
                                                    Width="120" />
                                <DataGridTextColumn Header="{loc:Tr students.firstName}"
                                                    Binding="{Binding FirstName}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{loc:Tr students.lastName}"
                                                    Binding="{Binding LastName}"
                                                    Width="*" />
                                <DataGridTemplateColumn Header="{loc:Tr common.actions}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Tr enrollment.enroll}"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.EnrollCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{loc:Tr enrollment.noResults}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Tr enrollment.enrolledStudents}"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,8" />
                    <Grid>
                        <DataGrid ItemsSource="{Binding Enrolled}"
                                  SelectedItem="{Binding SelectedEnrolled, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr students.sortCode}"
                                                    Binding="{Binding StudentCode}"
                                                    Width="120" />
                                <DataGridTextColumn Header="{loc:Tr students.fullName}"
                                                    Binding="{Binding StudentName}"
                                                    Width="*" />
                                <DataGridTemplateColumn Header="{loc:Tr common.actions}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Tr enrollment.unenroll}"
                                                    Style="{StaticResource LinkButton}"
                                                    Foreground="{DynamicResource Brush.Danger}"
                                                    Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{loc:Tr enrollment.noStudents}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEnrolled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
