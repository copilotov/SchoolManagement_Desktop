<UserControl x:Class="SchoolManagement.Desktop.Views.StudentCardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{loc:Tr students.cardPrint}"
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Content="{loc:Tr students.cardSavePdf}"
                            Command="{Binding SavePdfCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" />
                    <Button Content="{loc:Tr students.cardClose}"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource Brush.SurfaceVariant}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,16,0,0">
            <Border Style="{StaticResource Card}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="18">
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       MaxWidth="620"
                       MaxHeight="420"
                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
