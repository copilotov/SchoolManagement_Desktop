<UserControl x:Class="SchoolManagement.Desktop.Views.StudentCardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StudentCardViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="900"
             d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D5 - the printable student card. The preview stays the exact
         QuestPDF render used by the PDF, so print and screen cannot drift. The
         zoom is a LayoutTransform, which keeps the image crisp at every step.
         ===================================================================== -->

    <DockPanel Margin="{StaticResource Inset.Page}">
        <StackPanel DockPanel.Dock="Top">
            <controls:PageHeader Breadcrumb="{loc:Tr menu.students}"
                                 Title="{Binding Title}">
                <controls:PageHeader.ActionsContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Subtle}"
                                Content="-"
                                FontSize="16"
                                Width="36"
                                Command="{Binding ZoomOutCommand}"
                                ToolTip="{loc:Tr students.zoom}"
                                AutomationProperties.Name="{loc:Tr students.zoom}"
                                Margin="0,0,4,0" />
                        <TextBlock Style="{StaticResource Text.Numeric}"
                                   MinWidth="48"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding ZoomText}" />
                        <Button Style="{StaticResource Button.Subtle}"
                                Content="+"
                                FontSize="16"
                                Width="36"
                                Command="{Binding ZoomInCommand}"
                                ToolTip="{loc:Tr students.zoom}"
                                AutomationProperties.Name="{loc:Tr students.zoom}"
                                Margin="4,0,8,0" />
                        <Button Content="{loc:Tr students.cardPrint}"
                                Command="{Binding PrintCommand}"
                                Style="{StaticResource Button.Primary}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Tr students.cardSavePdf}"
                                Command="{Binding SavePdfCommand}"
                                Style="{StaticResource Button.Secondary}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Tr students.cardClose}"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </controls:PageHeader.ActionsContent>
            </controls:PageHeader>

            <Border Style="{StaticResource Banner.Danger}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,16,0,0">
            <Border Style="{StaticResource Component.Card}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="18">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </Border.LayoutTransform>
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       MaxWidth="620"
                       MaxHeight="420"
                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
