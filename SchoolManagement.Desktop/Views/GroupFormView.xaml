<UserControl x:Class="SchoolManagement.Desktop.Views.GroupFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <StackPanel>
        <TextBlock Text="{Binding EditorTitle}"
                   Style="{StaticResource SectionHeader}"
                   Margin="0,0,0,12" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr groups.name}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="*"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   ToolTip="{loc:Tr common.required}" />
                    </StackPanel>
                    <TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr groups.grade}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="*"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   ToolTip="{loc:Tr common.required}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Grades}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedEditorGrade, Mode=TwoWay}" />
                    <TextBlock Text="{loc:Tr groups.noGrades}"
                               Style="{StaticResource PageSubtitle}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr groups.subject}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="*"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   ToolTip="{loc:Tr common.required}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Subjects}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedEditorSubject, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="{loc:Tr groups.teacher}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Teachers}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedEditorTeacher, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="{loc:Tr groups.maxStudents}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditorMaxStudents, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0">
                    <TextBlock Text="{loc:Tr groups.monthlyFee}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditorMonthlyFee, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <CheckBox Grid.Row="3" Grid.Column="2"
                          VerticalAlignment="Bottom"
                          Margin="0,12,0,8"
                          IsChecked="{Binding EditorIsActive, Mode=TwoWay}"
                          Content="{loc:Tr common.active}" />
            </Grid>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="{loc:Tr common.cancel}"
                    Command="{Binding CancelEditorCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" />
            <Button Content="{loc:Tr common.save}"
                    Command="{Binding SaveEditorCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
