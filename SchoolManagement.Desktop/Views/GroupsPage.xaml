<UserControl x:Class="SchoolManagement.Desktop.Views.GroupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GroupsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="900"
             d:DesignWidth="1280"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- =====================================================================
         Phase D5 - the group list.

         One view model owns the query, the card/table switch, the grouping and
         the shared add/edit form. The table is the D3 DataTable; the card view
         groups the same rows into one section per level/teacher so a manager can
         scan a whole stage at once. Every label, badge and amount is resolved by
         the view model or goes through {loc:Tr}.
         ===================================================================== -->

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding EditSelectedCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelEditorCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SaveEditorCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Capacity meter inside a table cell. The bar owns its own thresholds. -->
        <DataTemplate x:Key="Groups.CapacityCell">
            <controls:CapacityBar Current="{Binding ActiveEnrollments}"
                                  Maximum="{Binding MaxStudents}"
                                  ShowValue="True"
                                  MinWidth="110"
                                  VerticalAlignment="Center" />
        </DataTemplate>

        <!-- Weekly slots: the count when scheduled, a quiet hint otherwise. -->
        <DataTemplate x:Key="Groups.ScheduleCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Numeric}"
                           Text="{Binding WeeklySlots}"
                           Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Component.Hint}"
                           Margin="4,0,0,0"
                           Text="{loc:Tr groups.slotsPerWeek}"
                           Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Component.Hint}"
                           Text="{loc:Tr groups.noSlotsShort}"
                           Visibility="{Binding HasSchedule, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Row actions: the DataTable keeps selection and the context menu, the
             cell keeps the four destinations one click away. -->
        <DataTemplate x:Key="Groups.ActionsCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{loc:Tr groups.details}"
                        Style="{StaticResource Button.Link}"
                        Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Content="{loc:Tr groups.manageStudents}"
                        Style="{StaticResource Button.Link}"
                        Margin="8,0,0,0"
                        Command="{Binding DataContext.EnrollCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Content="{loc:Tr groups.schedule}"
                        Style="{StaticResource Button.Link}"
                        Margin="8,0,0,0"
                        Command="{Binding DataContext.ScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Content="{loc:Tr common.edit}"
                        Style="{StaticResource Button.Link}"
                        Margin="8,0,0,0"
                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Content="{loc:Tr common.delete}"
                        Style="{StaticResource Button.Link}"
                        Margin="8,0,0,0"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
            </StackPanel>
        </DataTemplate>

        <!-- One group card. The card is a Border, not a button: the four actions
             below it are the only interactive surfaces. -->
        <DataTemplate x:Key="Groups.Card">
            <Border Style="{StaticResource Component.Card}"
                    Width="320"
                    Margin="0,0,12,12"
                    Padding="{StaticResource Inset.Card.Compact}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.BodyStrong}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource Component.Hint}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Placement}" />
                        </StackPanel>

                        <controls:StatusBadge Grid.Column="1"
                                              Text="{Binding StatusText}"
                                              Tone="{Binding StatusTone}"
                                              ShowDot="True"
                                              VerticalAlignment="Top" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource Component.Hint}"
                                   Text="{loc:Tr groups.subject}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource Text.Body}"
                                   Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SubjectText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource Component.Hint}"
                                   Margin="0,6,0,0"
                                   Text="{loc:Tr groups.teacher}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource Text.Body}"
                                   Margin="10,6,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding TeacherText}" />
                    </Grid>

                    <controls:CapacityBar Current="{Binding Item.ActiveEnrollments}"
                                          Maximum="{Binding Item.MaxStudents}"
                                          Caption="{loc:Tr groups.capacity}"
                                          ShowValue="True"
                                          Margin="0,12,0,0" />

                    <controls:StatusBadge Text="{Binding SlotsBadge}"
                                          Tone="{Binding SlotsTone}"
                                          Glyph="{StaticResource Icon.Calendar}"
                                          HorizontalAlignment="Left"
                                          Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Tr groups.details}"
                                Style="{StaticResource Button.Link}"
                                Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Item}" />
                        <Button Content="{loc:Tr groups.schedule}"
                                Style="{StaticResource Button.Link}"
                                Margin="8,0,0,0"
                                Command="{Binding DataContext.ScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Item}" />
                        <Button Content="{loc:Tr groups.manageStudents}"
                                Style="{StaticResource Button.Link}"
                                Margin="8,0,0,0"
                                Command="{Binding DataContext.EnrollCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Item}" />
                        <Button Content="{loc:Tr common.edit}"
                                Style="{StaticResource Button.Link}"
                                Margin="8,0,0,0"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Item}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One grouping section: a heading (hidden when there is no grouping)
             and the wrapped cards of that level/teacher. -->
        <DataTemplate x:Key="Groups.Section">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Component.SectionTitle}"
                           Margin="0,0,0,10"
                           Text="{Binding Title}"
                           Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource Groups.Card}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="{StaticResource Inset.Page}">

            <!-- Header -->
            <controls:PageHeader DockPanel.Dock="Top"
                                 Breadcrumb="{loc:Tr menu.groups}"
                                 Title="{loc:Tr groups.title}">
                <controls:PageHeader.ActionsContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding AddCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Icon.Add}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr groups.add}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Secondary}"
                                Command="{Binding GenerateAllCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Glyph}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{StaticResource Icon.Calendar}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr groups.generateSessions}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding OpenTimetableCommand}"
                                ToolTip="{loc:Tr timetable.title}"
                                AutomationProperties.Name="{loc:Tr timetable.title}"
                                Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Grid}" />
                        </Button>

                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ReloadCommand}"
                                ToolTip="{loc:Tr common.refresh}"
                                AutomationProperties.Name="{loc:Tr common.refresh}">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Refresh}" />
                        </Button>
                    </StackPanel>
                </controls:PageHeader.ActionsContent>
            </controls:PageHeader>

            <!-- Filter bar -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Component.Card}"
                    Padding="{StaticResource Inset.Card.Compact}"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchBox Grid.Column="0"
                                        Placeholder="{loc:Tr groups.searchHint}"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        SearchCommand="{Binding SearchCommand}" />

                    <ComboBox Grid.Column="1"
                              Width="150"
                              Margin="8,0,0,0"
                              ToolTip="{loc:Tr common.sortBy}"
                              AutomationProperties.Name="{loc:Tr common.sortBy}"
                              ItemsSource="{Binding SortOptions}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />

                    <CheckBox Grid.Column="2"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding SortDescending, Mode=TwoWay}"
                              Content="{loc:Tr common.sortDescending}" />

                    <CheckBox Grid.Column="3"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IncludeInactive, Mode=TwoWay}"
                              Content="{loc:Tr common.includeInactive}" />

                    <ComboBox Grid.Column="4"
                              Width="150"
                              Margin="8,0,0,0"
                              ToolTip="{loc:Tr groups.groupBy}"
                              AutomationProperties.Name="{loc:Tr groups.groupBy}"
                              ItemsSource="{Binding GroupingOptions}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedGrouping, Mode=TwoWay}" />

                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ShowTableCommand}"
                                ToolTip="{loc:Tr groups.viewTable}"
                                AutomationProperties.Name="{loc:Tr groups.viewTable}"
                                Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.List}" />
                        </Button>
                        <Button Style="{StaticResource Button.Subtle}"
                                Command="{Binding ShowCardsCommand}"
                                ToolTip="{loc:Tr groups.viewCards}"
                                AutomationProperties.Name="{loc:Tr groups.viewCards}">
                            <TextBlock Style="{StaticResource Icon.Glyph}" Text="{StaticResource Icon.Grid}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Banners -->
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Banner.Danger}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:Tr license.renewNow}"
                            Command="{Binding RenewLicenseCommand}"
                            Style="{StaticResource Button.Link}"
                            Margin="12,0,0,0"
                            Visibility="{Binding IsRenewVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Banner.Success}"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Table -->
            <controls:DataTable Margin="0,16,0,0"
                                Visibility="{Binding IsTableView, Converter={StaticResource BoolToVisibility}}"
                                ItemsSource="{Binding Items}"
                                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                ItemActivatedCommand="{Binding DetailsCommand}"
                                EditCommand="{Binding EditSelectedCommand}"
                                DeleteCommand="{Binding DeleteSelectedCommand}"
                                AddCommand="{Binding AddCommand}"
                                RefreshCommand="{Binding ReloadCommand}"
                                ShowSearch="False"
                                ShowDetailPanel="False"
                                EmptyTitle="{loc:Tr groups.empty}"
                                EmptyDescription="{loc:Tr groups.noGroupsSection}"
                                EmptyActionText="{loc:Tr groups.add}"
                                EmptyActionCommand="{Binding AddCommand}"
                                EmptyGlyph="{StaticResource Icon.Groups}">
                <controls:DataTable.Columns>
                    <controls:DataTableColumn Header="{loc:Tr groups.name}"
                                              BindingPath="Name"
                                              Width="160" />
                    <controls:DataTableColumn Header="{loc:Tr groups.grade}"
                                              BindingPath="GradeName"
                                              Width="110" />
                    <controls:DataTableColumn Header="{loc:Tr groups.subject}"
                                              BindingPath="SubjectName"
                                              Width="130" />
                    <controls:DataTableColumn Header="{loc:Tr groups.teacher}"
                                              BindingPath="TeacherName"
                                              Width="140" />
                    <controls:DataTableColumn Header="{loc:Tr groups.monthlyFee}"
                                              BindingPath="MonthlyFee"
                                              Width="100"
                                              IsNumeric="True"
                                              StringFormat="{}{0:0.##}" />
                    <controls:DataTableColumn Header="{loc:Tr groups.capacity}"
                                              BindingPath="CapacityText"
                                              Width="150"
                                              CellTemplate="{StaticResource Groups.CapacityCell}" />
                    <controls:DataTableColumn Header="{loc:Tr groups.weeklySchedule}"
                                              BindingPath="WeeklySlots"
                                              Width="120"
                                              IsNumeric="True"
                                              CellTemplate="{StaticResource Groups.ScheduleCell}" />
                    <controls:DataTableColumn Header="{loc:Tr common.actions}"
                                              Width="2*"
                                              CellTemplate="{StaticResource Groups.ActionsCell}" />
                </controls:DataTable.Columns>
            </controls:DataTable>

            <!-- Cards -->
            <ScrollViewer Margin="0,16,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsCardView, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Sections}"
                                  ItemTemplate="{StaticResource Groups.Section}" />

                    <controls:EmptyState Title="{loc:Tr groups.empty}"
                                         Description="{loc:Tr groups.noGroupsSection}"
                                         Glyph="{StaticResource Icon.Groups}"
                                         ActionText="{loc:Tr groups.add}"
                                         ActionCommand="{Binding AddCommand}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Top"
                                         Margin="0,40,0,0"
                                         Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- Shared add/edit form, in a D3 side panel -->
        <controls:SidePanel IsOpen="{Binding IsEditorOpen, Mode=TwoWay}"
                            Title="{Binding EditorTitle}"
                            PanelWidth="480"
                            CloseCommand="{Binding CancelEditorCommand}">
            <controls:SidePanel.PanelContent>
                <views:GroupFormView DataContext="{Binding}" />
            </controls:SidePanel.PanelContent>
            <controls:SidePanel.ActionsContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr common.cancel}"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding CancelEditorCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:Tr common.save}"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveEditorCommand}" />
                </StackPanel>
            </controls:SidePanel.ActionsContent>
        </controls:SidePanel>
    </Grid>
</UserControl>
