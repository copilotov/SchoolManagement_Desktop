<UserControl x:Class="SchoolManagement.Desktop.Views.NavRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="240"
             d:DesignHeight="820">

    <!-- =====================================================================
         Phase D2 - the side navigation rail.
         One grouped ListBox: selection, keyboard navigation and the accent
         marker all stay in a single control, so a language switch only refreshes
         the captions instead of rebuilding the visual tree.
         ===================================================================== -->

    <Border Background="{DynamicResource Surface.Alt}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand -->
            <Grid Grid.Row="0" Margin="14,14,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="32"
                        Height="32"
                        CornerRadius="{StaticResource Radius.Element}"
                        Background="{DynamicResource Accent}">
                    <TextBlock Text="{StaticResource Icon.School}"
                               FontFamily="{StaticResource Font.Family.Icons}"
                               FontSize="16"
                               Foreground="{DynamicResource Text.OnAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding SchoolName}"
                               Style="{StaticResource Text.BodyStrong}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{loc:Tr app.subtitle}"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Destinations, grouped Home / Academic / Finance / Communication / System -->
            <ListBox x:Name="DestinationList"
                     Grid.Row="1"
                     ItemsSource="{Binding ItemsView}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,4,0,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Items[0].GroupLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NavGroupCaption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Glyph}"
                                       Style="{StaticResource NavGlyph}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Label}"
                                       Margin="10,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NavLabel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Grid.Column="2"
                                    Style="{StaticResource NavBadge}"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding BadgeText}"
                                           Style="{StaticResource NavBadgeText}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavRailItem}">
                        <Setter Property="ToolTip" Value="{Binding Label}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Footer: license status, theme, language, help -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Padding="8,8">
                <StackPanel>
                    <!-- Expanded footer -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Command="{Binding License.RenewCommand}"
                                Style="{StaticResource Button.Subtle}"
                                HorizontalContentAlignment="Stretch"
                                Height="32"
                                ToolTip="{loc:Tr shell.licenseStatus}"
                                AutomationProperties.Name="{loc:Tr shell.licenseStatus}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding License.Severity}" Value="Warning">
                                                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding License.Severity}" Value="Danger">
                                                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding License.Severity}" Value="Info">
                                                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding License.StatusText}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Command="{Binding ToggleThemeCommand}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="{loc:Tr shell.theme}"
                                    AutomationProperties.Name="{loc:Tr shell.theme}">
                                <TextBlock Text="{Binding ThemeGlyph}"
                                           FontFamily="{StaticResource Font.Family.Icons}"
                                           FontSize="16" />
                            </Button>

                            <Button Command="{Binding CycleLanguageCommand}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="{loc:Tr shell.language}"
                                    AutomationProperties.Name="{loc:Tr shell.language}">
                                <TextBlock Text="{Binding LanguageBadge}"
                                           Style="{StaticResource Text.Caption}"
                                           FontWeight="SemiBold" />
                            </Button>

                            <Button Command="{Binding OpenShortcutsCommand}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="{loc:Tr shell.help}"
                                    AutomationProperties.Name="{loc:Tr shell.help}">
                                <TextBlock Text="{StaticResource Icon.Help}"
                                           FontFamily="{StaticResource Font.Family.Icons}"
                                           FontSize="16" />
                            </Button>

                            <Button Command="{Binding ToggleNavCommand}"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="{loc:Tr shell.collapseNav}"
                                    AutomationProperties.Name="{loc:Tr shell.collapseNav}">
                                <TextBlock Text="{StaticResource Icon.NavCollapse}"
                                           FontFamily="{StaticResource Font.Family.Icons}"
                                           FontSize="16" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Compact footer -->
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavCollapsed}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="{loc:Tr shell.theme}"
                                AutomationProperties.Name="{loc:Tr shell.theme}">
                            <TextBlock Text="{Binding ThemeGlyph}"
                                       FontFamily="{StaticResource Font.Family.Icons}"
                                       FontSize="16" />
                        </Button>

                        <Button Command="{Binding CycleLanguageCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="{loc:Tr shell.language}"
                                AutomationProperties.Name="{loc:Tr shell.language}">
                            <TextBlock Text="{Binding LanguageBadge}"
                                       Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold" />
                        </Button>

                        <Button Command="{Binding ToggleNavCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="{loc:Tr shell.expandNav}"
                                AutomationProperties.Name="{loc:Tr shell.expandNav}">
                            <TextBlock Text="{StaticResource Icon.NavExpand}"
                                       FontFamily="{StaticResource Font.Family.Icons}"
                                       FontSize="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
