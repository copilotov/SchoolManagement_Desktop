<UserControl x:Class="SchoolManagement.Desktop.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization">
    <Border Height="32"
            Background="{DynamicResource Brush.StatusBar}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Reserved for the license banner. The licensing phase will show
                 Active/Expiring/Grace/ReadOnly messages here. -->
            <Border x:Name="LicenseBannerHost"
                    Grid.Column="0"
                    Padding="8,2"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr settings.appVersion}"
                           Style="{StaticResource StatusText}"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding AppVersion}"
                           Style="{StaticResource StatusText}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
