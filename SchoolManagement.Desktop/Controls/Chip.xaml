<UserControl x:Class="SchoolManagement.Desktop.Controls.Chip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Phase D3 - removable chip for tags, filters and selected values. -->
    <Border x:Name="Surface"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Pill}"
            Padding="8,2"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="GlyphBlock"
                       Style="{StaticResource Icon.Glyph}"
                       FontSize="11"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Text="{Binding Glyph, ElementName=Root}"
                       Visibility="{Binding Glyph, ElementName=Root, Converter={StaticResource StringToVisibility}}" />

            <TextBlock x:Name="Label"
                       Style="{StaticResource Component.BadgeText}"
                       VerticalAlignment="Center"
                       Text="{Binding Text, ElementName=Root}" />

            <Button x:Name="CloseButton"
                    Style="{StaticResource Button.Icon}"
                    Width="18"
                    Height="18"
                    MinWidth="18"
                    MinHeight="18"
                    Padding="0"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Tr common.clear}"
                    Click="OnCloseClick"
                    Visibility="{Binding ShowClose, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Icon.Glyph}"
                           FontSize="9"
                           Text="{StaticResource Icon.Clear}" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
