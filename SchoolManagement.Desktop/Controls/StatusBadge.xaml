<UserControl x:Class="SchoolManagement.Desktop.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Phase D3 - status badge. The tone is semantic (attendance, finance,
         session, license, homework), so the same pill means the same thing
         everywhere and repaints with the theme. -->
    <Border x:Name="Surface"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Pill}"
            Padding="8,2"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="GlyphBlock"
                       Style="{StaticResource Icon.Glyph}"
                       FontSize="11"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Text="{Binding Glyph, ElementName=Root}"
                       Visibility="{Binding Glyph, ElementName=Root, Converter={StaticResource StringToVisibility}}" />

            <Ellipse x:Name="Dot"
                     Width="6"
                     Height="6"
                     Margin="0,0,4,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding ShowDot, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock x:Name="Label"
                       Style="{StaticResource Component.BadgeText}"
                       Text="{Binding Text, ElementName=Root}" />
        </StackPanel>
    </Border>
</UserControl>
