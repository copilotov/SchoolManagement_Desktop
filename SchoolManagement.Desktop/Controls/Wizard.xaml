<UserControl x:Class="SchoolManagement.Desktop.Controls.Wizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Phase D3 - stepper / wizard. Step markers and the current content are
         built in code so the current, completed and upcoming states share one
         set of semantic brushes. -->
    <Border Style="{StaticResource Component.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="StepHost" Orientation="Horizontal" />
            </ScrollViewer>

            <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="0,14,0,0" />

            <ContentPresenter x:Name="ContentHost" Grid.Row="2" Margin="0,16,0,0" />

            <StackPanel x:Name="NavigationHost"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="BackButton"
                        Style="{StaticResource Button.Secondary}"
                        Content="{loc:Tr common.previous}"
                        Click="OnBackClick" />
                <Button x:Name="NextButton"
                        Style="{StaticResource Button.Primary}"
                        Margin="8,0,0,0"
                        Content="{loc:Tr common.next}"
                        Click="OnNextClick" />
                <Button x:Name="FinishButton"
                        Style="{StaticResource Button.Primary}"
                        Margin="8,0,0,0"
                        Content="{loc:Tr common.finish}"
                        Click="OnFinishClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
