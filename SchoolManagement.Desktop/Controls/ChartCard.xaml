<UserControl x:Class="SchoolManagement.Desktop.Controls.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Phase D3 - chart card. The series, axes and paints are rebuilt in code
         so every colour comes from the live palette; ThemeMonitor triggers a
         rebuild, because LiveCharts2 consumes concrete SKColor values. -->
    <Border Style="{StaticResource Component.ChartCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Component.SectionTitle}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Title, ElementName=Root}" />
                    <TextBlock Style="{StaticResource Component.Hint}"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="{Binding Description, ElementName=Root}"
                               Visibility="{Binding Description, ElementName=Root, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>

                <ContentPresenter Grid.Column="1"
                                  VerticalAlignment="Top"
                                  Content="{Binding ActionsContent, ElementName=Root}" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Style="{StaticResource Text.Numeric}"
                       Margin="0,0,0,8"
                       Text="{Binding Summary, ElementName=Root}"
                       Visibility="{Binding Summary, ElementName=Root, Converter={StaticResource StringToVisibility}}" />

            <Grid Grid.Row="2" MinHeight="160">
                <lvc:CartesianChart x:Name="Chart"
                                    Background="Transparent"
                                    AnimationsSpeed="0:0:0.2"
                                    TooltipPosition="Top"
                                    LegendPosition="Hidden"
                                    Visibility="{Binding ShowEmptyState, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}" />

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyState, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Icon.Glyph}"
                               FontSize="32"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Text.Disabled}"
                               Text="{StaticResource Icon.Chart}" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding EmptyText, ElementName=Root}"
                               Visibility="{Binding EmptyText, ElementName=Root, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
