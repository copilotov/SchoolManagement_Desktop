<UserControl x:Class="SchoolManagement.Desktop.Controls.DataTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Phase D3 - the list surface every screen will use: instant search,
         column filters, column chooser, density, multi-select bulk bar, export,
         empty state, skeleton, paging, context menu and a master-detail panel.
         No literal colour or literal text lives here. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:SearchBox x:Name="Search"
                                Grid.Column="0"
                                MaxWidth="320"
                                HorizontalAlignment="Left"
                                Placeholder="{loc:Tr common.search}"
                                Text="{Binding SearchText, ElementName=Root, Mode=TwoWay}"
                                Visibility="{Binding ShowSearch, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ContentPresenter Content="{Binding ToolbarContent, ElementName=Root}"
                                  VerticalAlignment="Center" />

                <Button x:Name="ColumnsButton"
                        Style="{StaticResource Component.IconButton}"
                        Margin="0,0,4,0"
                        ToolTip="{loc:Tr components.columns}"
                        AutomationProperties.Name="{loc:Tr components.columns}"
                        Click="OnColumnsClick"
                        Visibility="{Binding ShowColumnChooser, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Icon.Glyph}"
                               FontSize="14"
                               Text="{StaticResource Icon.Columns}" />
                </Button>

                <Button x:Name="DensityButton"
                        Style="{StaticResource Component.IconButton}"
                        Margin="0,0,4,0"
                        ToolTip="{loc:Tr components.density}"
                        AutomationProperties.Name="{loc:Tr components.density}"
                        Click="OnDensityClick">
                    <TextBlock Style="{StaticResource Icon.Glyph}"
                               FontSize="14"
                               Text="{StaticResource Icon.Density}" />
                </Button>

                <Button x:Name="RefreshButton"
                        Style="{StaticResource Component.IconButton}"
                        Margin="0,0,4,0"
                        ToolTip="{loc:Tr common.refresh}"
                        AutomationProperties.Name="{loc:Tr common.refresh}"
                        Command="{Binding RefreshCommand, ElementName=Root}"
                        Visibility="{Binding RefreshCommand, ElementName=Root, Converter={StaticResource ObjectToVisibility}}">
                    <TextBlock Style="{StaticResource Icon.Glyph}"
                               FontSize="14"
                               Text="{StaticResource Icon.Refresh}" />
                </Button>

                <Button x:Name="ExportButton"
                        Style="{StaticResource Component.ToolbarButton}"
                        Command="{Binding ExportCommand, ElementName=Root}"
                        Visibility="{Binding ExportCommand, ElementName=Root, Converter={StaticResource ObjectToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon.Glyph}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Text="{StaticResource Icon.Export}" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Tr components.export}" />
                    </StackPanel>
                </Button>

                <Button x:Name="AddButton"
                        Style="{StaticResource Button.Primary}"
                        MinHeight="{StaticResource Control.Height.Compact}"
                        Padding="12,4"
                        Command="{Binding AddCommand, ElementName=Root}"
                        Visibility="{Binding AddCommand, ElementName=Root, Converter={StaticResource ObjectToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon.Glyph}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Text="{StaticResource Icon.Add}" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Tr common.add}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Popup x:Name="ColumnsPopup"
                   PlacementTarget="{Binding ElementName=ColumnsButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Border.Strong}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Element}"
                        Padding="{StaticResource Inset.Card.Compact}"
                        Effect="{StaticResource Shadow.Md}">
                    <StackPanel MinWidth="180">
                        <TextBlock Style="{StaticResource Component.BadgeText}"
                                   Margin="0,0,0,8"
                                   Text="{loc:Tr components.columns}" />
                        <ItemsControl ItemsSource="{Binding Columns, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,2"
                                              Content="{Binding Header}"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Bulk action bar: only while a selection exists -->
        <Border Grid.Row="1"
                Background="{DynamicResource Accent.Container}"
                BorderBrush="{DynamicResource Accent}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Element}"
                Padding="12,6"
                Margin="0,0,0,8"
                Visibility="{Binding HasSelection, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Component.BadgeText}"
                               Foreground="{DynamicResource Accent.OnContainer}"
                               VerticalAlignment="Center"
                               Text="{loc:Tr components.selected}" />
                    <TextBlock Style="{StaticResource Text.Numeric}"
                               Foreground="{DynamicResource Accent.OnContainer}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding SelectionCount, ElementName=Root}" />
                </StackPanel>

                <ContentPresenter Grid.Column="1"
                                  Margin="16,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content="{Binding BulkActionsContent, ElementName=Root}" />

                <Button Grid.Column="2"
                        Style="{StaticResource Button.Subtle}"
                        MinHeight="{StaticResource Control.Height.Compact}"
                        Padding="10,4"
                        Content="{loc:Tr common.deselectAll}"
                        Click="OnClearSelectionClick" />
            </Grid>
        </Border>

        <!-- Table + master-detail panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <DataGrid x:Name="Table"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="56"
                          GridLinesVisibility="Horizontal"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Sorting="OnSorting"
                          SelectionChanged="OnSelectionChanged"
                          MouseDoubleClick="OnRowDoubleClick"
                          PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown" />

                <controls:SkeletonLoader x:Name="Skeleton"
                                         Rows="6"
                                         IsActive="{Binding IsBusy, ElementName=Root}"
                                         VerticalAlignment="Top"
                                         Margin="0,64,0,0"
                                         Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

                <controls:EmptyState x:Name="Empty"
                                     VerticalAlignment="Center"
                                     Title="{Binding EmptyTitle, ElementName=Root}"
                                     Description="{Binding EmptyDescription, ElementName=Root}"
                                     ActionText="{Binding EmptyActionText, ElementName=Root}"
                                     ActionCommand="{Binding EmptyActionCommand, ElementName=Root}"
                                     Glyph="{Binding EmptyGlyph, ElementName=Root}"
                                     Visibility="{Binding IsEmpty, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Border Grid.Column="1"
                    Width="340"
                    Style="{StaticResource Component.DetailPanel}"
                    Visibility="{Binding IsDetailOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding SelectedItem, ElementName=Root}"
                                    ContentTemplate="{Binding DetailTemplate, ElementName=Root}" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Pager -->
        <Grid Grid.Row="3"
              Margin="0,10,0,0"
              Visibility="{Binding ShowPager, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Text.Secondary}"
                           VerticalAlignment="Center"
                           Text="{loc:Tr components.page}" />
                <TextBlock Style="{StaticResource Text.Numeric}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentPage, ElementName=Root}" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Text.Secondary}"
                           Margin="4,0"
                           VerticalAlignment="Center"
                           Text="/" />
                <TextBlock Style="{StaticResource Text.Numeric}"
                           VerticalAlignment="Center"
                           Text="{Binding PageCount, ElementName=Root}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PreviousButton"
                        Style="{StaticResource Component.ToolbarButton}"
                        Click="OnPreviousPageClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon.Glyph}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="{StaticResource Icon.ChevronLeft}" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Tr common.previous}" />
                    </StackPanel>
                </Button>

                <Button x:Name="NextButton"
                        Style="{StaticResource Component.ToolbarButton}"
                        Click="OnNextPageClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Tr common.next}" />
                        <TextBlock Style="{StaticResource Icon.Glyph}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="{StaticResource Icon.ChevronRight}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
