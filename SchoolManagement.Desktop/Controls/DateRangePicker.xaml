<UserControl x:Class="SchoolManagement.Desktop.Controls.DateRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:SchoolManagement.Desktop.Behaviors"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Phase D3 - from/to date range. The separator chevron is a directional
         glyph, so it flips automatically in RTL. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Text.Secondary}"
                       Margin="0,0,0,4"
                       Text="{Binding StartLabel, ElementName=Root}"
                       Visibility="{Binding StartLabel, ElementName=Root, Converter={StaticResource StringToVisibility}}" />
            <DatePicker SelectedDate="{Binding StartDate, ElementName=Root, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding StartLabel, ElementName=Root}" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Style="{StaticResource Icon.Glyph}"
                   FontSize="14"
                   Margin="10,0"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="{StaticResource Icon.ChevronRight}"
                   behaviors:RtlMirrorBehavior.IsEnabled="True" />

        <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Text.Secondary}"
                       Margin="0,0,0,4"
                       Text="{Binding EndLabel, ElementName=Root}"
                       Visibility="{Binding EndLabel, ElementName=Root, Converter={StaticResource StringToVisibility}}" />
            <DatePicker SelectedDate="{Binding EndDate, ElementName=Root, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding EndLabel, ElementName=Root}" />
        </StackPanel>
    </Grid>
</UserControl>
