<UserControl x:Class="SchoolManagement.Desktop.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Phase D3 - instant search field with a leading glyph and a clear
         button. The text updates on every keystroke, so filtering is live. -->
    <Border x:Name="Surface"
            Height="36"
            Background="{DynamicResource Surface.Card}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Control}"
            MouseLeftButtonDown="OnSurfaceMouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource Icon.Glyph}"
                       FontSize="14"
                       Margin="10,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{StaticResource Icon.Search}" />

            <Grid Grid.Column="1">
                <TextBox x:Name="Input"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalContentAlignment="Center"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnInputKeyDown" />

                <TextBlock Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Text.Disabled}"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="{Binding Placeholder, ElementName=Root}"
                           Visibility="{Binding Text, ElementName=Root, Converter={StaticResource InverseStringToVisibility}}" />
            </Grid>

            <Button Grid.Column="2"
                    Style="{StaticResource Button.Icon}"
                    Width="28"
                    Height="28"
                    MinWidth="28"
                    MinHeight="28"
                    Margin="4,0,4,0"
                    Padding="0"
                    AutomationProperties.Name="{loc:Tr common.clear}"
                    Click="OnClearClick"
                    Visibility="{Binding Text, ElementName=Root, Converter={StaticResource StringToVisibility}}">
                <TextBlock Style="{StaticResource Icon.Glyph}"
                           FontSize="10"
                           Text="{StaticResource Icon.Clear}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
