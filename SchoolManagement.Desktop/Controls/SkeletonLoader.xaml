<UserControl x:Class="SchoolManagement.Desktop.Controls.SkeletonLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Phase D3 - loading skeleton with a moving highlight. The animation is
         skipped entirely when Windows "Animation effects" is off, so a reduced
         motion user sees static placeholder bars. -->
    <Grid x:Name="Host" ClipToBounds="True">
        <StackPanel x:Name="BarHost" />

        <Rectangle x:Name="Shimmer"
                   IsHitTestVisible="False"
                   Opacity="0.55"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.5" Color="{DynamicResource Surface.Hover}" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="ShimmerTransform" X="-600" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
