<UserControl x:Class="SchoolManagement.Desktop.Controls.Dialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding IsOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}">

    <!-- Phase D3 - one dialog for a confirmation or a small form. It never owns
         business rules: the caller passes already-localized text and commands. -->
    <Grid>
        <Border Background="{DynamicResource Overlay.Scrim}"
                MouseLeftButtonDown="OnScrimClick" />

        <Border x:Name="Card"
                Width="480"
                MaxHeight="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Strong}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Effect="{StaticResource Shadow.Lg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,16,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Subtitle}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Title, ElementName=Root}" />
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="{Binding Description, ElementName=Root}"
                                   Visibility="{Binding Description, ElementName=Root, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Icon}"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{loc:Tr common.close}"
                            Click="OnCloseClick">
                        <TextBlock Style="{StaticResource Icon.Glyph}"
                                   FontSize="12"
                                   Text="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,0,20,8">
                    <ContentPresenter Content="{Binding DialogContent, ElementName=Root}" />
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{DynamicResource Surface.Alt}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="20,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SecondaryButton"
                                Style="{StaticResource Button.Secondary}"
                                Content="{Binding SecondaryText, ElementName=Root}"
                                Command="{Binding SecondaryCommand, ElementName=Root}"
                                Visibility="{Binding SecondaryCommand, ElementName=Root, Converter={StaticResource ObjectToVisibility}}" />

                        <Button x:Name="PrimaryButton"
                                Style="{StaticResource Button.Primary}"
                                Margin="8,0,0,0"
                                Content="{Binding PrimaryText, ElementName=Root}"
                                Command="{Binding PrimaryCommand, ElementName=Root}"
                                Visibility="{Binding PrimaryCommand, ElementName=Root, Converter={StaticResource ObjectToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
