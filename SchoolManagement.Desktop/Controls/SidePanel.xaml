<UserControl x:Class="SchoolManagement.Desktop.Controls.SidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SchoolManagement.Desktop.Localization"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding IsOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}">

    <!-- Phase D3 - drawer for a quick add/edit. It is anchored to the trailing
         edge (the right in LTR, the left in RTL because FlowDirection mirrors
         HorizontalAlignment). -->
    <Grid>
        <Border x:Name="Scrim"
                Background="{DynamicResource Overlay.Scrim}"
                MouseLeftButtonDown="OnScrimClick"
                Visibility="{Binding ShowScrim, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />

        <Border x:Name="Panel"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="{Binding PanelWidth, ElementName=Root}"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Strong}"
                BorderThickness="1,0,0,0"
                Effect="{StaticResource Shadow.Lg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{StaticResource Inset.Card.Compact}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource Text.Subtitle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Title, ElementName=Root}" />

                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Icon}"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            AutomationProperties.Name="{loc:Tr common.close}"
                            Click="OnCloseClick">
                        <TextBlock Style="{StaticResource Icon.Glyph}"
                                   FontSize="12"
                                   Text="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="{StaticResource Inset.Card.Compact}">
                        <ContentPresenter Content="{Binding PanelContent, ElementName=Root}" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource Surface.Alt}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="{StaticResource Inset.Card.Compact}">
                    <ContentPresenter Content="{Binding ActionsContent, ElementName=Root}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
